library(dplyr); library(readr); library(stringr)
data_dir <- Sys.getenv("BOREAL_DATA_DIR",
unset = "/Users/jacobmoutouama/Dropbox/Moutouama Lab/Manuscripts/Canada medicinal plants/Database")
out_dir  <- file.path(data_dir, "clean")
gbif_dir <- file.path(data_dir, "gbif")
dwc_dir  <- file.path(data_dir, "DWC-cb678c4a-6b9c-43e9-92d5-2dc3d4c15b7d", "clean")
uses <- read_csv(file.path(out_dir, "uprety_uses.csv"), show_col_types = FALSE)
# All peoples with no language family (Metis is expected; anything else needs a decision)
uses |>
filter(!is.na(people), is.na(language_family)) |>
count(people_original, people, sort = TRUE) |>
print(n = Inf)
# Full list, to check spellings that weren't merged
uses |> count(people, language_family, sort = TRUE) |> print(n = Inf)
gbif_keys <- read_csv(file.path(gbif_dir, "gbif_species_keys.csv"), show_col_types = FALSE)
retry_ok  <- read_csv(file.path(gbif_dir, "gbif_species_keys_retry.csv"), show_col_types = FALSE)
already   <- unique(c(gbif_keys$speciesKey, retry_ok$speciesKey))
area <- st_read(file.path(out_dir, "boreal_canada.gpkg"), layer = "boreal_hemiboreal", quiet = TRUE) |>
st_transform(3978) |> st_buffer(50000) |> st_simplify(dTolerance = 20000) |>
st_transform(4326) |> st_make_valid()
area_wkt <- st_as_text(st_sfc(st_geometry(area)[[1]], crs = 4326, check_ring_dir = TRUE), digits = 4)
fix_types <- function(d) mutate(d, gbifID = as.character(gbifID),
speciesKey = as.numeric(speciesKey),
across(any_of(c("institutionCode", "datasetKey",
"basisOfRecord", "countryCode")), as.character))
