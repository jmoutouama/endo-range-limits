mutate(climate_mm = exp(clim * ppt_sd + ppt_mean))
# Δ-panel limits for each species (same, only Δ panel)
y_limits_inf <- plot_data_inf %>%
filter(panel == "Δ (E+ - E-)") %>%
group_by(species) %>%
summarise(
