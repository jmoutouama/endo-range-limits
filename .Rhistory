# ─────────────────────────────────────────────────────────────────────────────
sa_full <- sa_growth %>%
left_join(clim_plot_mean, by = c("Enumer_id", "LID", "Species")) %>%
rename(Longitude = Longitude.x, Latitude = Latitude.x) %>%
select(-ends_with(".y")) %>%
left_join(gdd_plot, by = c("Enumer_id", "LID", "Species")) %>%
mutate(
SpeciesName = species_labels[Species],
log_Htm     = log(Htm + 1),
log_SI      = log(SI  + 1),
GDD_z       = as.numeric(scale(GDD_annual)),
P2_z        = P_mean_z^2,
Age_z       = as.numeric(scale(Age))
) %>%
filter(!is.na(T_max_mean), !is.na(Htm), !is.na(GDD_annual))
sa_full
# ── Within/between GDD decomposition ─────────────────────────────────────────
sa_full <- sa_full %>%
group_by(LID) %>%
mutate(
GDD_site_mean = mean(GDD_annual, na.rm = TRUE),
GDD_deviation = GDD_annual - GDD_site_mean   # true climate signal
) %>%
ungroup() %>%
mutate(
Age_z           = as.numeric(scale(Age)),
GDD_site_mean_z = as.numeric(scale(GDD_site_mean)),
GDD_deviation_z = as.numeric(scale(GDD_deviation))
# Rad_index_z and TPI_macro_z already scaled
)
sa_full
cat("sa_full: N =", nrow(sa_full),
"| Species:", n_distinct(sa_full$Species), "\n")
lid_species <- sa_full %>% distinct(LID, Species, SpeciesName)
# ── Baseline model ────────────────────────────────────────────────────────────
m_full <- lmer(
Htm ~ Age_z +
GDD_site_mean_z +
GDD_deviation_z +
Rad_index_z +
TPI_macro_z +
(1 | LID) +
(1 | SpeciesName),
data = sa_full,
REML = TRUE
)
cat("\n── m_full summary ──\n")
print(summary(m_full))
# ── Species-specific climate sensitivity model ────────────────────────────────
m_species <- lmer(
Htm ~ Age_z +
GDD_deviation_z * SpeciesName +
GDD_site_mean_z +
Rad_index_z +
TPI_macro_z +
(1 | LID),
data = sa_full,
REML = TRUE
)
cat("\n── m_species summary ──\n")
print(summary(m_species))
# ── Model comparison (ML for valid LRT) ───────────────────────────────────────
m_full_ml    <- update(m_full,    REML = FALSE)
m_species_ml <- update(m_species, REML = FALSE)
cat("\n── ANOVA: m_full vs m_species ──\n")
print(anova(m_full_ml, m_species_ml))
# ─────────────────────────────────────────────────────────────────────────────
# 8.  EXTRACT SPECIES CLIMATE SENSITIVITY (buffering metric)
# ─────────────────────────────────────────────────────────────────────────────
ref_slope <- fixef(m_species)["GDD_deviation_z"]
# All species names present in model
spp_in_model <- sa_full %>%
distinct(SpeciesName) %>%
pull(SpeciesName) %>%
sort()
# Reference species is the one not appearing in interaction terms
ref_species <- setdiff(
spp_in_model,
gsub("GDD_deviation_z:SpeciesName", "", grep("GDD_deviation_z:SpeciesName",
names(fixef(m_species)), value = TRUE))
)
cat("Reference species:", ref_species, "\n")
# Build sensitivity table
species_sensitivity <- tibble(SpeciesName = spp_in_model) %>%
mutate(
interaction_term = paste0("GDD_deviation_z:SpeciesName", SpeciesName),
delta_slope = purrr::map_dbl(interaction_term, function(nm) {
if (nm %in% names(fixef(m_species))) fixef(m_species)[nm] else 0
}),
total_slope = ref_slope + delta_slope,
# Buffering index: deviation from network mean (negative = buffered)
buffering   = total_slope - mean(total_slope),
category    = case_when(
buffering < -0.2 ~ "Buffered",
buffering >  0.2 ~ "Sensitive",
TRUE             ~ "Intermediate"
)
) %>%
arrange(total_slope)
cat("\n── Species climate sensitivity ranking ──\n")
print(species_sensitivity %>%
select(SpeciesName, total_slope, buffering, category), n = Inf)
# ─────────────────────────────────────────────────────────────────────────────
