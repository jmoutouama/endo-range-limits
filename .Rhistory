gdd_lm_stats <- sa_full %>%
group_by(SpeciesName) %>%
filter(sum(!is.na(GDD_annual) & !is.na(Htm)) >= 10) %>%
summarize(fit = list(lm(Htm ~ GDD_annual)), .groups = "drop") %>%
mutate(
slope = purrr::map_dbl(fit, ~ coef(.x)[["GDD_annual"]]),
r2    = purrr::map_dbl(fit, ~ summary(.x)$r.squared),
pval  = purrr::map_dbl(fit, ~ {
s <- summary(.x)
if (nrow(s$coefficients) >= 2) s$coefficients[2, 4]
else NA_real_
}),
sig   = case_when(pval < 0.001 ~ "***", pval < 0.01 ~ "**",
pval < 0.05  ~ "*",   TRUE         ~ "ns"),
label = paste0("β = ", formatC(slope, format = "f", digits = 4),
"\nR² = ", formatC(r2, format = "f", digits = 2), " ", sig)
) %>%
select(SpeciesName, slope, r2, pval, sig, label)
gdd_range <- sa_full %>%
group_by(SpeciesName) %>%
summarize(x_pos = quantile(GDD_annual, 0.05, na.rm = TRUE),
y_pos = max(Htm, na.rm = TRUE) * 0.92, .groups = "drop")
