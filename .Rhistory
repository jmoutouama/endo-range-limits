aes(x = temp_mismatch, y = Htd_z,
color = Age)
) +
geom_point(alpha = 0.25, size = 0.7) +
# Fix: map x and y explicitly inside geom_smooth
geom_smooth(
aes(x = temp_mismatch, y = Htd_z),
method    = "lm",
formula   = y ~ x + I(x^2),
color     = "black",
linewidth = 1.4,
se        = TRUE,
fill      = "grey30",
alpha     = 0.2
) +
geom_hline(yintercept = 0, linetype = "dashed",
color = "grey50", linewidth = 0.5) +
geom_vline(xintercept = 0, linetype = "dashed",
color = "grey50", linewidth = 0.5) +
scale_color_viridis_c(
option = "turbo",
name   = "Stand age (years)",
breaks = c(5, 15, 25, 40, 60),
guide  = guide_colorbar(
barwidth  = 1,
barheight = 8,
ticks     = TRUE
)
) +
labs(
x        = "Temperature mismatch (°C)\n← cooler than planted  |  warmer than planted →",
y        = "Dominant height (z-scored)",
# title    = "d) Climate debt reduces growth",
subtitle = "Quadratic fit across all species and ages"
) +
theme_classic(base_size = 12) +
theme(
legend.position = "right",
legend.title    = element_text(size = 10),
legend.text     = element_text(size = 9)
)
