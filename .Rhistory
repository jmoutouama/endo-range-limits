PET = NA_real_, WB = NA_real_,
SPEI3 = NA_real_, LID = lid)
}
)
})
cat("SPEI computed: N =", nrow(spei_monthly),
"| NA SPEI3:", sum(is.na(spei_monthly$SPEI3)), "\n")
# Summarise SPEI to plot level
spei_plot <- stands_monthly %>%
left_join(spei_monthly, by = c("LID", "Year", "Month")) %>%
group_by(Enumer_id, LID, Species) %>%
summarize(
SPEI3_mean        = mean(SPEI3,  na.rm = TRUE),
SPEI3_min         = min(SPEI3,   na.rm = TRUE),
SPEI3_cv          = sd(SPEI3,    na.rm = TRUE) /
abs(mean(SPEI3, na.rm = TRUE) + 1e-6),
WB_annual         = mean(WB,     na.rm = TRUE) * 12,
n_drought_months  = sum(SPEI3 < -1, na.rm = TRUE),
.groups           = "drop"
)
cat("SPEI plot summary: N =", nrow(spei_plot), "\n")
# ─────────────────────────────────────────────────────────────────────────────
# 7.  ASSEMBLE sa_full
# ─────────────────────────────────────────────────────────────────────────────
sa_full <- sa_growth %>%
left_join(clim_plot_mean, by = c("Enumer_id", "LID", "Species")) %>%
rename(Longitude = Longitude.x, Latitude = Latitude.x) %>%
select(-ends_with(".y")) %>%
left_join(gdd_plot,  by = c("Enumer_id", "LID", "Species")) %>%
left_join(spei_plot, by = c("Enumer_id", "LID", "Species")) %>%
mutate(
# SpeciesName uses FULL LATIN NAMES — must match spp_cols keys
SpeciesName = species_labels[Species],
log_Htm     = log(Htm + 1),
log_SI      = log(SI  + 1),
GDD_z       = as.numeric(scale(GDD_annual)),
SPEI3_z     = as.numeric(scale(SPEI3_mean)),
P2_z        = P_mean_z^2,
Age_z       = as.numeric(scale(Age))
) %>%
filter(!is.na(T_max_mean), !is.na(Htm))
cat("sa_full: N =", nrow(sa_full),
"| Species:", n_distinct(sa_full$Species), "\n")
cat("GDD missing:", sum(is.na(sa_full$GDD_annual)),
"| SPEI missing:", sum(is.na(sa_full$SPEI3_mean)), "\n")
# Confirm palette alignment — this must print TRUE for all species
cat("\nColour palette check:\n")
present_names <- unique(sa_full$SpeciesName)
cat("All SpeciesName values in spp_cols?",
all(present_names %in% names(spp_cols)), "\n")
# If FALSE, print the mismatches:
if (!all(present_names %in% names(spp_cols))) {
cat("MISSING:", setdiff(present_names, names(spp_cols)), "\n")
}
# ─────────────────────────────────────────────────────────────────────────────
# 8.  FIGURE 1 — STUDY-AREA MAP
# ─────────────────────────────────────────────────────────────────────────────
plots_sf <- sa_full %>%
distinct(LID, Species, SpeciesName, Longitude, Latitude, T_max_mean) %>%
filter(!is.na(Longitude), !is.na(Latitude)) %>%
st_as_sf(coords = c("Longitude", "Latitude"), crs = 4326)
buf      <- 0.5;  bb <- st_bbox(plots_sf)
xmin_val <- as.numeric(bb["xmin"]) - buf
xmax_val <- as.numeric(bb["xmax"]) + buf
ymin_val <- as.numeric(bb["ymin"]) - buf
ymax_val <- as.numeric(bb["ymax"]) + buf
sa_country   <- ne_countries(country = "South Africa",
scale = "medium", returnclass = "sf")
sa_provinces <- ne_states(country = "South Africa", returnclass = "sf")
focal_pts <- plots_sf %>% filter(Species == FOCAL_SPECIES)
other_pts <- plots_sf %>% filter(Species != FOCAL_SPECIES)
fig1_main <- ggplot() +
geom_sf(data = sa_provinces, fill = "grey96", colour = "grey70",
linewidth = 0.2) +
geom_sf(data = sa_country, fill = NA, colour = "grey30",
linewidth = 0.45) +
geom_sf(data  = other_pts, aes(colour = T_max_mean),
shape = 16, size = 1.0, alpha = 0.5) +
geom_sf(data  = focal_pts, aes(colour = T_max_mean),
shape = 21, size = 2.8, fill = NA, stroke = 1.1) +
scale_colour_viridis_c(name = "Mean\nT_max (°C)", option = "inferno") +
annotation_scale(location = "bl", width_hint = 0.2, style = "ticks") +
annotation_north_arrow(location = "tr", style = north_arrow_minimal()) +
coord_sf(xlim = c(xmin_val, xmax_val),
ylim = c(ymin_val, ymax_val), expand = FALSE) +
labs(title    = "Study area — South African pine plantation network",
subtitle = paste0("Points coloured by mean T_max  |  Outlined = ",
FOCAL_NAME),
x = "Longitude", y = "Latitude") +
theme_pub()
fig1_main
inset_map <- ggplot() +
geom_sf(data = sa_country, fill = "grey90", colour = "grey50",
linewidth = 0.3) +
annotate("rect",
xmin = xmin_val, xmax = xmax_val,
ymin = ymin_val, ymax = ymax_val,
fill = NA, colour = "#E34234", linewidth = 0.9) +
theme_void() +
theme(panel.border = element_rect(colour = "grey40", fill = NA,
linewidth = 0.5))
fig1 <- ggdraw(fig1_main) +
draw_plot(inset_map, x = 0.64, y = 0.06, width = 0.28, height = 0.28)
fig1
# Step 1: compute annual means per LID
site_annual_clim <- clim_monthly %>%
group_by(LID, Year) %>%
summarize(
T_max_ann = mean(Tmax, na.rm = TRUE),
T_min_ann = mean(Tmin, na.rm = TRUE),
T_ave_ann = mean(Tave, na.rm = TRUE),
P_ann     = sum(PPT,   na.rm = TRUE),
.groups   = "drop"
)
# Step 2: only keep LIDs that appear in our plantation data
lid_species <- sa_full %>% distinct(LID, Species, SpeciesName)
site_annual_clim <- site_annual_clim %>%
inner_join(distinct(lid_species, LID), by = "LID")
# Step 3: compute NETWORK-WIDE annual mean ± SD across all sites
# This gives ONE ribbon per year, not 2082 spaghetti lines
network_annual <- site_annual_clim %>%
group_by(Year) %>%
summarize(
Tmax_mean = mean(T_max_ann, na.rm = TRUE),
Tmax_sd   = sd(T_max_ann,   na.rm = TRUE),
Tmin_mean = mean(T_min_ann, na.rm = TRUE),
Tmin_sd   = sd(T_min_ann,   na.rm = TRUE),
Tave_mean = mean(T_ave_ann, na.rm = TRUE),
Tave_sd   = sd(T_ave_ann,   na.rm = TRUE),
P_mean    = mean(P_ann,     na.rm = TRUE),
P_sd      = sd(P_ann,       na.rm = TRUE),
n_sites   = n(),
.groups   = "drop"
) %>%
filter(n_sites >= 5)   # only years with enough sites
# Panel A: temperature — Tave trend + Tmax/Tmin ribbon
fig2a <- ggplot(network_annual, aes(x = Year)) +
# Tmax ribbon
geom_ribbon(aes(ymin = Tmax_mean - Tmax_sd,
ymax = Tmax_mean + Tmax_sd),
fill = "#E74C3C", alpha = 0.12) +
geom_line(aes(y = Tmax_mean, colour = "T_max"),
linewidth = 0.7, alpha = 0.7) +
# Tmin ribbon
geom_ribbon(aes(ymin = Tmin_mean - Tmin_sd,
ymax = Tmin_mean + Tmin_sd),
fill = "#3498DB", alpha = 0.12) +
geom_line(aes(y = Tmin_mean, colour = "T_min"),
linewidth = 0.7, alpha = 0.7) +
# Tave — focal trend line + LOESS smoother
geom_ribbon(aes(ymin = Tave_mean - Tave_sd,
ymax = Tave_mean + Tave_sd),
fill = "#2ECC71", alpha = 0.15) +
geom_line(aes(y = Tave_mean, colour = "T_ave"),
linewidth = 0.9) +
geom_smooth(aes(y = Tave_mean, group = 1),
method = "loess", span = 0.35,
colour = "#1A5276", fill = "#1A5276",
alpha = 0.20, linewidth = 1.2) +
scale_colour_manual(
values = c("T_max" = "#E74C3C",
"T_ave" = "#27AE60",
"T_min" = "#2980B9"),
name = NULL,
labels = c("T_ave" = "Mean (T_ave)",
"T_max" = "Maximum (T_max)",
"T_min" = "Minimum (T_min)")
) +
scale_x_continuous(breaks = seq(1940, 2025, 20)) +
labs(x = "Year",
y = "Temperature (°C)",
title = "A  Temperature trends across all plantation sites",
subtitle = paste0(
"Lines = network mean  |  Ribbons = ±1 SD across sites\n",
"Blue LOESS = long-term T_ave trend"
)) +
theme_pub() +
theme(legend.position = c(0.15, 0.85))
fig2a
# Panel B: precipitation
fig2b <- ggplot(network_annual, aes(x = Year)) +
geom_ribbon(aes(ymin = P_mean - P_sd, ymax = P_mean + P_sd),
fill = "#3498DB", alpha = 0.18) +
geom_line(aes(y = P_mean), colour = "#2471A3", linewidth = 0.9) +
geom_smooth(aes(y = P_mean, group = 1),
method = "loess", span = 0.35,
colour = "#1A5276", fill = "#1A5276",
alpha = 0.20, linewidth = 1.2) +
scale_x_continuous(breaks = seq(1940, 2025, 20)) +
labs(x = "Year",
y = "Annual precipitation (mm)",
title = "B  Precipitation trends across all plantation sites",
subtitle = "Line = network mean  |  Ribbon = ±1 SD across sites") +
theme_pub()
fig2b
fig2 <- (fig2a / fig2b) +
plot_annotation(
title    = "Figure 2. Long-term climate trends across the plantation network (1931–2025)",
subtitle = paste0("Network of ", n_distinct(site_annual_clim$LID),
" plantation sites")
)
fig2
