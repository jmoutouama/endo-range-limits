\contentsline {table}{\numberline {S-3}{\ignorespaces Comparison of candidate models (quadratic vs. linear) for each vital rate based on leave-one-out cross-validation (LOOCV). ELPD difference is relative to the best model.}}{27}{table.caption.9}%
\contentsline {table}{\numberline {S-4}{\ignorespaces Posterior summaries of $\Delta $ (E$^{+}$ $-$ E$^{-}$) for survival at precipitation quantiles for each species and herbivore exclusion treatment. Median, 90\% credible interval, and posterior probability that $\Delta > 0$ are shown. Herbivore exclusion: Fenced = herbivores excluded, Unfenced = herbivores had access.}}{28}{table.caption.10}%
\contentsline {table}{\numberline {S-5}{\ignorespaces Posterior summaries of $\Delta $ (E$^{+}$ $-$ E$^{-}$) for growth across precipitation quantiles for each species and herbivore treatment. Positive median values indicate beneficial effects of endophytes; negative medians indicate costly effects.}}{29}{table.caption.11}%
\contentsline {table}{\numberline {S-6}{\ignorespaces Posterior summaries of $\Delta $ (E$^{+}$ $-$ E$^{-}$) for flowering output at precipitation quantiles for each species and herbivore exclusion treatment. Median, 90\% credible interval, and posterior probability that $\Delta > 0$ are shown. Herbivore exclusion: Fenced = herbivores excluded, Unfenced = herbivores had access.}}{30}{table.caption.12}%
\contentsline {table}{\numberline {S-7}{\ignorespaces Posterior summaries of $\Delta $ (E$^{+}$ $-$ E$^{-}$) at precipitation quantiles for each species and herbivore exclusion treatment. Median, 90\% credible interval, and posterior probability that $\Delta > 0$ are shown. Herbivore exclusion: Fenced = herbivores excluded, Unfenced = herbivores had access.}}{31}{table.caption.13}%
\contentsline {table}{\numberline {S-8}{\ignorespaces Posterior summaries of interaction effects (mean estimate, 95\% credible intervals, and posterior probability) for survival, growth, flowering, and spikelet production across three grass species.}}{32}{table.caption.14}%
