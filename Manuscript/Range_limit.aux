\@writefile{lot}{\contentsline {table}{\numberline {S-2}{\ignorespaces Model comparison by vital rate using ELPD (Expected Log Pointwise Density) differences. The values in the \textbf  {elpd\_diff} column represent the difference in the model's ELPD relative to the best model for each vital rate, with positive values indicating a worse model fit. The \textbf  {se\_diff} column shows the standard error of the ELPD difference. Best models for each vital rate are bolded. Model selection is based on the ELPD difference and associated standard error, with smaller ELPD differences and lower standard errors indicating better model fit.}}{17}{table.caption.9}\protected@file@percent }
\newlabel{tab:elpd_vital_rates}{{S-2}{17}{Model comparison by vital rate using ELPD (Expected Log Pointwise Density) differences. The values in the \textbf {elpd\_diff} column represent the difference in the model's ELPD relative to the best model for each vital rate, with positive values indicating a worse model fit. The \textbf {se\_diff} column shows the standard error of the ELPD difference. Best models for each vital rate are bolded. Model selection is based on the ELPD difference and associated standard error, with smaller ELPD differences and lower standard errors indicating better model fit}{table.caption.9}{}}
