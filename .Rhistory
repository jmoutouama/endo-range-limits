library(sf)             # spatial operations
library(rnaturalearth)  # world map data
library(dplyr)          # data manipulation
library(tidyr)          # data wrangling
library(ggplot2)        # plotting
library(readr)          # reading CSV
library(scales)         # transparency for plotting
library(units)
# Load and clean gallery forest dataset
gallery_sites <- read_csv("/Users/jacobmoutouama/Dropbox/Gallery forest project/Jacob's_version/Gallery forest/Review/Data/gallery_sites.csv")
head(gallery_sites)
names(gallery_sites)
# head(gallery_sites)
# names(gallery_sites)
gallery_sites_clean <- gallery_sites %>%
select(
wos_id, title, Treatment, mean_treatment, sd_treatment,
Control, mean_control, sd_control,
dd_lon, dd_lat, goal_new,
Floristic_surveys, Hypothesis_testing, Conservation, Trait, Climate_change, gallery_forest
) %>%
mutate(
dd_lon = as.numeric(dd_lon),
dd_lat = as.numeric(dd_lat)
) %>%
filter(
gallery_forest == 1,
!is.na(dd_lon), !is.na(dd_lat),
dd_lat >= -60 & dd_lat <= 60,
dd_lon >= -180 & dd_lon <= 180
)
gallery_sites_clean
# Convert to sf object
gallery_sites_sf <- st_as_sf(
gallery_sites_clean,
coords = c("dd_lon", "dd_lat"),
crs = 4326
)
gallery_sites_sf
# Convert to sf object
gallery_sites_sf <- st_as_sf(
gallery_sites_clean,
coords = c("dd_lon", "dd_lat"),
crs = 4326
)
gallery_sites_sf
str(gallery_sites_sf)
# Define offshore reference point and filter
offshore_point <- st_sfc(st_point(c(-109.4363, -26.9342)), crs = 4326)
gallery_sites_sf <- gallery_sites_sf %>%
mutate(dist_km = as.numeric(st_distance(geometry, offshore_point)) / 1000) %>%
filter(dist_km > 25)
gallery_sites_sf
# Load world map and filter points on land
world <- ne_countries(scale = "large", returnclass = "sf") %>%
st_make_valid() %>%
st_wrap_dateline(options = c("WRAPDATELINE=YES"), quiet = TRUE)
plot(world)
gallery_sites_sf <- st_join(
gallery_sites_sf,
world %>% select(continent),
join = st_intersects,
left = FALSE
) %>%
rename(Continent = continent)
