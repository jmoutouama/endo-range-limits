\@writefile{lot}{\contentsline {table}{\numberline {S11}{\ignorespaces Greenhouse experiment: posterior summaries of the endophyte main effect ($S^+$) and its interaction with soil-origin precipitation for each fitness component. For each model, the table reports the median estimate, 95\% credible interval (Lower and Upper), and the posterior probability that the effect is greater than zero (P($\beta >0$)).}}{17}{table.caption.11}\protected@file@percent }
\newlabel{tab:posterior_soil}{{S11}{17}{Greenhouse experiment: posterior summaries of the endophyte main effect ($S^+$) and its interaction with soil-origin precipitation for each fitness component. For each model, the table reports the median estimate, 95\% credible interval (Lower and Upper), and the posterior probability that the effect is greater than zero (P($\beta >0$))}{table.caption.11}{}}
