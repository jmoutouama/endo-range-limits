# Define some basic functions that we'll use later
quote_bare <- function(...) {
substitute(alist(...)) %>%
eval() %>%
sapply(deparse)
}
set.seed(13)
# Survival
fit_surv_ppt <- readRDS(url("https://www.dropbox.com/scl/fi/0g5pn2igdi65vr3ky7heh/fit_surv_ppt.rds?rlkey=pkdj56oi1s3mfdn4p8nkgvlpy&dl=1"))
post_surv<-rstan::extract(fit_surv_ppt)
# Growth----
fit_grow_ppt <- readRDS(url("https://www.dropbox.com/scl/fi/5oduhrkn3l0cu5b9soju5/fit_grow_ppt.rds?rlkey=mpxxl4aejowhdm29pij9jv8kk&dl=1"))
post_grow <- rstan::extract(fit_grow_ppt)
# Flowering----
fit_flow_ppt <- readRDS(url("https://www.dropbox.com/scl/fi/1j3ln3jxk94s56c9j193q/fit_flow_ppt.rds?rlkey=ag5bdlhngtg2gsfbfbx15purr&dl=1"))
post_flow <- rstan::extract(fit_flow_ppt)
# SPikelets----
fit_spik_ppt <- readRDS(url("https://www.dropbox.com/scl/fi/fg562lkkl077j8qoegb8q/fit_spik_ppt.rds?rlkey=cbfyy7tq7tja3e9mxujv0scm6&dl=1"))
post_spik <- rstan::extract(fit_spik_ppt)
# Stack all draws together
post_all <- cbind(post_surv, post_grow, post_flow,post_spik)
# Compute correlation for each posterior draw
cor_draws <- apply(post_all, 1, function(x) cor(x[1:ncol(post_surv)], x[(ncol(post_surv)+1):(ncol(post_surv)+ncol(post_grow))]))
post_surv <- posterior::as_draws_df(fit_surv)
# Example for brms/Stan objects:
post_surv <- posterior::as_draws_df(fit_surv_ppt)
post_grow <- posterior::as_draws_df(fit_grow_ppt)
post_flow <- posterior::as_draws_df(fit_flow_ppt)
post_spik <- posterior::as_draws_df(post_spik)
n_draws <- min(nrow(post_surv), nrow(post_grow), nrow(post_flow), nrow(post_spik))
post_surv2 <- post_surv[sample(nrow(post_surv), n_draws), ]
post_grow2 <- post_grow[sample(nrow(post_grow), n_draws), ]
post_flow2 <- post_flow[sample(nrow(post_flow), n_draws), ]
post_spik2 <- post_spik[sample(nrow(post_spik), n_draws), ]
# Function to compute correlation for each draw
compute_cor <- function(surv, other) {
apply(cbind(surv, other), 1, function(x) cor(x[1:ncol(surv)], x[(ncol(surv)+1):length(x)]))
}
cor_surv_grow <- compute_cor(post_surv2, post_grow2)
pred_surv <- post_surv$Pred  # dims: draws x treatments (or clim points)
pred_grow <- post_grow$Pred
pred_flow <- post_flow$Pred
pred_spik <- post_spik$Pred
fit_surv_ppt <- readRDS(url("https://www.dropbox.com/scl/fi/0g5pn2igdi65vr3ky7heh/fit_surv_ppt.rds?rlkey=pkdj56oi1s3mfdn4p8nkgvlpy&dl=1"))
post_surv <- rstan::extract(fit_surv_ppt)
fit_grow_ppt <- readRDS(url("https://www.dropbox.com/scl/fi/5oduhrkn3l0cu5b9soju5/fit_grow_ppt.rds?rlkey=mpxxl4aejowhdm29pij9jv8kk&dl=1"))
post_grow <- rstan::extract(fit_grow_ppt)
fit_flow_ppt <- readRDS(url("https://www.dropbox.com/scl/fi/1j3ln3jxk94s56c9j193q/fit_flow_ppt.rds?rlkey=ag5bdlhngtg2gsfbfbx15purr&dl=1"))
post_flow <- rstan::extract(fit_flow_ppt)
fit_spik_ppt <- readRDS(url("https://www.dropbox.com/scl/fi/fg562lkkl077j8qoegb8q/fit_spik_ppt.rds?rlkey=cbfyy7tq7tja3e9mxujv0scm6&dl=1"))
post_spik <- rstan::extract(fit_spik_ppt)
# --- 2. Build posterior data frame ---
# If your spikelet model has quadratic term, evaluate at mean ppt (or other typical value)
mean_ppt <- 50  # adjust based on your data range
df_post <- data.frame(
Survival  = plogis(post_surv$b_Intercept), # assuming logit link
Growth    = post_grow$b_Intercept,         # linear
Flowering = post_flow$b_Intercept,         # linear
Spikelets = post_spik$b_Intercept +
post_spik$b_ppt*mean_ppt +
post_spik$b_ppt2*mean_ppt^2    # quadratic
)
