# Number of populations (genotypes) per species
pop_counts <- dat_t_t1 %>%
group_by(Species) %>%
summarise(n_populations = n_distinct(Population),
n_clones = n_distinct(Tag_ID))
pop_counts
endo_counts <- dat_t_t1 %>%
group_by(Species, Population, Endo) %>%
summarise(n_individuals = n(), .groups = "drop") %>%
tidyr::pivot_wider(names_from = Endo, values_from = n_individuals,
names_prefix = "Endo_") %>%
replace(is.na(.), 0)  # replace missing counts with 0
endo_counts
# Number of populations (genotypes) per species
# Unique populations and clones per species
dat_t_t1 %>%
group_by(Species) %>%
summarise(
n_populations = length(unique(Population)),
n_clones = length(unique(Tag_ID))
)
unique(dat_t_t1$Population)
unique(dat_t_t1$Tag_ID)
endo_counts
# Number of populations (genotypes) per species
# Unique populations and clones per species
endo_counts <- dat_t_t1 %>%
group_by(Species, Population, Endo) %>%
summarise(n_individuals = n(), .groups = "drop") %>%
pivot_wider(names_from = Endo, values_from = n_individuals,
names_prefix = "Endo_") %>%
replace(is.na(.), 0) %>%   # replace missing counts with 0
mutate(n_clones = Endo_0 + Endo_1)  # add total clones column
endo_counts
