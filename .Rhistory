library(lme4)
library(MuMIn)
install.packages("MuMIn")
library(MuMIn)
# What explains height growth?
m1 <- lmer(Htd_z ~ age_z + (1|species_idx),
data = sa_growth_life, REML = FALSE)
m2 <- lmer(Htd_z ~ age_z + temp_anomaly_z +
(1|species_idx),
data = sa_growth_life, REML = FALSE)
m3 <- lmer(Htd_z ~ age_z + temp_anomaly_z +
temp_mismatch_z +
(1|species_idx),
data = sa_growth_life, REML = FALSE)
m4 <- lmer(Htd_z ~ age_z + temp_anomaly_z +
temp_mismatch_z + warming_rate_z +
(1|species_idx),
data = sa_growth_life, REML = FALSE)
# Compare
cat("Age only:\n")
print(r.squaredGLMM(m1))
cat("+ temp anomaly:\n")
print(r.squaredGLMM(m2))
cat("+ mismatch:\n")
print(r.squaredGLMM(m3))
cat("+ warming rate:\n")
print(r.squaredGLMM(m4))
# AIC comparison
AIC(m1, m2, m3, m4)
species_lookup
# Question 1 — Does SI vary with climate mismatch?
# SI removes the age-height problem entirely
ggplot(sa_growth_life,
aes(x = temp_mismatch, y = SI,
color = Species)) +
geom_point(alpha = 0.2, size = 0.6) +
geom_smooth(method = "lm", se = FALSE,
linewidth = 0.8) +
scale_color_viridis_d(option = "turbo") +
facet_wrap(~WPU) +
theme_classic(base_size = 12) +
labs(x = "Temperature mismatch (°C)",
y = "Site Index",
title = "Does climate debt affect site productivity?")
# Question 2 — Do species differ in SI across regions?
sa_growth_life %>%
group_by(Species, WPU) %>%
summarize(
mean_SI = round(mean(SI, na.rm = TRUE), 2),
n       = n(),
.groups = "drop"
) %>%
pivot_wider(names_from  = WPU,
values_from = mean_SI) %>%
print()
# See all rows clearly
sa_growth_life %>%
group_by(Species, WPU) %>%
summarize(
mean_SI = round(mean(SI, na.rm = TRUE), 2),
n       = n(),
.groups = "drop"
) %>%
pivot_wider(names_from  = WPU,
values_from = mean_SI,
values_fn   = mean) %>%
arrange(Species) %>%
print(n = Inf)
# Heatmap of SI by species x region
# Much clearer than a table
sa_growth_life %>%
group_by(Species, WPU) %>%
summarize(
mean_SI = mean(SI, na.rm = TRUE),
n       = n(),
.groups = "drop"
) %>%
filter(n >= 10) %>%  # remove very small samples
ggplot(aes(x = WPU, y = Species,
fill = mean_SI)) +
geom_tile(color = "white", linewidth = 0.5) +
geom_text(aes(label = round(mean_SI, 1)),
color = "white", size = 4,
fontface = "bold") +
scale_fill_viridis_c(option = "plasma",
name   = "Mean SI") +
labs(x = "Region",
y = "Species",
title    = "Site Index by species and region",
subtitle = "Higher = better productivity") +
theme_classic(base_size = 12) +
theme(axis.text.x = element_text(angle = 0))
# Does the regional SI pattern track climate?
# First check what climate differs between regions
sa_growth_life %>%
group_by(WPU) %>%
summarize(
mean_Tmax     = round(mean(temp_at_measurement,
na.rm = TRUE), 2),
mean_mismatch = round(mean(temp_mismatch,
na.rm = TRUE), 3),
mean_SI       = round(mean(SI, na.rm = TRUE), 2),
n             = n(),
.groups       = "drop"
) %>%
print()
# 1. Visualize the species x region SI heatmap
sa_growth_life %>%
group_by(Species, WPU) %>%
summarize(mean_SI = mean(SI, na.rm = TRUE),
n = n(), .groups = "drop") %>%
filter(n >= 20) %>%
ggplot(aes(x = WPU, y = reorder(Species, mean_SI),
fill = mean_SI)) +
geom_tile(color = "white", linewidth = 0.8) +
geom_text(aes(label = round(mean_SI, 1)),
color = "white", fontface = "bold",
size = 4.5) +
scale_fill_viridis_c(option = "plasma",
name   = "Mean SI") +
labs(x = "Region", y = "Species",
title    = "Site productivity (SI) by species and region",
subtitle = "Higher = more productive") +
theme_classic(base_size = 13)
# 2. Connect regional SI to regional climate
# Is the Highveld advantage driven by rainfall?
sa_growth_life %>%
group_by(WPU) %>%
summarize(
mean_rain     = round(mean(sum_rain_life,
na.rm = TRUE), 1),
mean_Tmax     = round(mean(temp_at_measurement,
na.rm = TRUE), 2),
mean_mismatch = round(mean(temp_mismatch,
na.rm = TRUE), 3),
mean_SI       = round(mean(SI, na.rm = TRUE), 2),
.groups       = "drop"
) %>%
print()
# Is sum_rain_life just tracking stand age?
cor.test(sa_growth_life$Age,
sa_growth_life$sum_rain_life,
method = "pearson")
# Plot it
ggplot(sa_growth_life,
aes(x = Age, y = sum_rain_life,
color = WPU)) +
geom_point(alpha = 0.2, size = 0.6) +
geom_smooth(method = "lm", se = FALSE,
linewidth = 1) +
scale_color_viridis_d(option = "plasma",
name = "Region") +
labs(x = "Stand age (years)",
y = "Total rainfall over lifetime (mm)",
title = "Is sum_rain_life just tracking age?") +
theme_classic(base_size = 12)
# Use ANNUAL rainfall instead
sa_growth_life %>%
group_by(WPU) %>%
summarize(
mean_annual_rain = round(mean(
sum_rain_life / Age,   # annual average
na.rm = TRUE), 1),
mean_SI  = round(mean(SI, na.rm = TRUE), 2),
mean_Age = round(mean(Age, na.rm = TRUE), 1),
.groups  = "drop"
) %>%
print()
