draws
# 1. posterior draws
draws <- herb_fit %>%
spread_draws(beta0[species],
beta_endo[species],
beta_fence[species])
# 2. prediction grid (treatment combinations)
newdat <- expand_grid(
species = 1:3,
fence = c(0, 1),
endo = c(0, 1)
)
# 3. posterior predictions on response scale
preds <- draws %>%
crossing(newdat) %>%
mutate(
eta =
beta0 +
beta_fence * fence +
beta_endo * endo,
mu = exp(eta)  # expected damaged tillers
)
# posterior draws
draws <- herb_fit %>%
spread_draws(beta0[species],
beta_fence[species],
beta_endo[species])
# prediction grid (rename species to avoid collision)
newdat <- expand_grid(
species_id = 1:3,
fence = c(0, 1),
endo = c(0, 1)
)
# match naming so join works cleanly
draws2 <- draws %>%
rename(species_id = species)
preds <- draws2 %>%
left_join(newdat, by = "species_id") %>%
mutate(
eta =
beta0 +
beta_fence * fence +
beta_endo * endo,
mu = exp(eta)
)
# 4. summarize as % (THIS is what reviewers want)
summary_tbl <- preds %>%
group_by(species, fence, endo) %>%
median_qi(mu, .width = 0.95) %>%
ungroup() %>%
mutate(
species = recode(species,
`1` = "AGHY",
`2` = "ELVI",
`3` = "POAU"),
treatment = ifelse(fence == 1, "Exclusion", "Access"),
endophyte = ifelse(endo == 1, "S+", "S-"),
mean_pct = 100 * mu,
lower_pct = 100 * .lower,
upper_pct = 100 * .upper
) %>%
select(species, treatment, endophyte,
mean_pct, lower_pct, upper_pct)
draws2 <- herb_fit %>%
spread_draws(beta0[species],
beta_fence[species],
beta_endo[species])
# prediction grid
newdat <- expand_grid(
species = 1:3,
fence = c(0, 1),
endo = c(0, 1)
)
# IMPORTANT: use crossing on NON-overlapping structure safely
preds <- draws2 %>%
crossing(newdat) %>%
mutate(
eta =
beta0 +
beta_fence * fence +
beta_endo * endo,
mu = exp(eta)
)
# posterior draws
draws2 <- herb_fit %>%
