herb = .$herb,
species = .$Spp,
plot = .$plot,
y = .$y
) %>%
group_by(plot, species, herb, clim, endo) %>%
summarise(
y_plot_mean = mean(y, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(panel = "Inflorescences",
climate_mm = exp(clim * ppt_sd + ppt_mean))
