"Tropical & Subtropical Moist Broadleaf Forests" = "#FF73DF",
"Tropical & Subtropical Dry Broadleaf Forests"   = "#00734C",
"Tropical & Subtropical Coniferous Forests"      = "#A1832A",
"Temperate Broadleaf & Mixed Forests"            = "#C23246",
"Temperate Conifer Forests"                      = "#A14AC7",
"Temperate Grasslands, Savannas & Shrublands"    = "#70B548",
"Flooded Grasslands & Savannas"                  = "#2BC23F",
"Montane Grasslands & Shrublands"                = "#3AC299",
"Tundra"                                         = "#FFBEBE",
"Boreal Forests/Taiga"                           = "#A35E33",
"Mediterranean Forests, Woodlands & Scrub"       = "#BBC236",
"Deserts & Xeric Shrublands"                     = "#E6E600",
"Mangroves"                                      = "#FFD37F",
"Tropical & Subtropical Grasslands, Savannas & Shrublands" = "#21339C",
"Rock & Ice"                                     = "#E1E1E1",
"Inland Water"                                   = "#2E99C7"
)
ecoregions$BiomeName <- biome_names[as.character(ecoregions$BIOME)]
# Transform to Robinson projection
robin_crs <- "ESRI:54030"
ecoregions_robin <- st_transform(ecoregions, crs = robin_crs)
world_robin      <- st_transform(world, crs = robin_crs)
sites_robin      <- st_transform(gallery_sites_sf, crs = robin_crs)
sites_robin$Legend <- "Gallery Forests"
ggplot() +
geom_sf(data = ecoregions_robin, aes(fill = BiomeName), color = NA) +
geom_sf(data = world_robin, fill = NA, color = "black", size = 0.1) +
geom_sf(data = sites_robin, aes(fill = Legend), color = "grey20", size = 0.75, alpha = 0.9) +
scale_fill_manual(
values = c(wwf_colors, "Gallery Forests" = "grey20"),
name = NULL
) +
guides(
fill = guide_legend(
ncol = 3,
override.aes = list(size = 0.3)
)
) +
theme_minimal() +
coord_sf(crs = "+proj=robin", expand = FALSE) +
theme(
legend.position = c(0.64, 0.19),
legend.key.size   = unit(0.2, "cm"),
legend.key.height = unit(0.10, "cm"),
legend.key.width  = unit(0.25, "cm"),
legend.text       = element_text(size = 4.5),
axis.title        = element_blank(),
axis.text         = element_blank(),
axis.ticks        = element_blank()
)
