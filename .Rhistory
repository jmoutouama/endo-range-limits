# 2. Plant organ use domains (e.g., Leaf, Root)
# 3. Conservation practice domains (e.g., Growth, Direct seeding)
#
# Models include fixed effects for Age (standardized) and Sex,
# with a random intercept for Locality.
# Posterior predictions and credible intervals are generated and visualized
# with ggplot2, with optional overlay of observed data.
# Effect sizes for Age and Sex are extracted and summarized across domains.
# -------------------------------
# Clear workspace
rm(list = ls())
# -------------------------------
# Libraries
library(tidyverse)
library(brms)
library(posterior)
library(patchwork)
library(ggpubr)
library(scales)
library(readr)
# -------------------------------
# Load data
data_hexmono <- read.csv(
"/Users/jacobmoutouama/Dropbox/Moutouama Lab/Undergraduates/Bariou/Data/data_Hexmono.csv",
stringsAsFactors = FALSE
)
# Ensure correct data types
data_hexmono <- data_hexmono %>%
mutate(
Locality   = factor(Locality),
Sex        = factor(Sex),
Occupation = factor(Occupation),
Ethnicity  = factor(Ethnicity),
Religion   = factor(Religion),
Age_s      = scale(Age)
)
# Summary
# Age range
range(data_hexmono$Age, na.rm = TRUE)
# Number and names of sociocultural groups
levels(factor(data_hexmono$Ethnicity))
table(data_hexmono$Ethnicity)
# Village/locality proportions
table(data_hexmono$Locality)
prop.table(table(data_hexmono$Locality)) * 100
# Check whether Locality and Ethnicity are confounded
table(data_hexmono$Locality, data_hexmono$Ethnicity)
