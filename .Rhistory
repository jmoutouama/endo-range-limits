fix_types <- function(d) mutate(d, gbifID = as.character(gbifID),
speciesKey = as.numeric(speciesKey),
across(any_of(c("institutionCode", "datasetKey",
"basisOfRecord", "countryCode")), as.character))
matching <- read_csv(file.path(out_dir, "uprety_name_matching.csv"), show_col_types = FALSE)
# (a) Did VASCAN's variety rule or your manual table decide these two?
matching |>
filter(uprety_taxon %in% c("Oligoneuron rigidum var. rigidum",
"Rumex salicifolius var. mexicanus")) |>
select(uprety_taxon, accepted_species, match_method, confidence)
# (b) Languages of vernacular names: which ones count as "Indigenous"?
vern <- read_csv(file.path(out_dir, "uprety_vernacular.csv"), show_col_types = FALSE)
vern |>
mutate(counted_as_indigenous = !language %in% c("English", "French")) |>
count(language, counted_as_indigenous, sort = TRUE) |>
print(n = Inf)
# The worrying cases: pairs where the shared GBIF species links a native and an
# introduced VASCAN species, or a medicinal and a non-medicinal one
shared |>
group_by(speciesKey) |>
filter(n_distinct(status_in_region) > 1 | n_distinct(medicinal) > 1) |>
print(n = Inf)
keys
keys  <- read_csv(file.path(gbif_dir, "gbif_species_keys_all.csv"), show_col_types = FALSE)
flora <- read_csv(file.path(out_dir, "master_species_table.csv"), show_col_types = FALSE)
shared <- keys |>
distinct(speciesKey, vascan_species, gbif_species) |>
group_by(speciesKey) |> filter(n_distinct(vascan_species) > 1) |> ungroup() |>
left_join(select(flora, species, status_in_region, in_boreal_hemi, medicinal,
n_cells_all, n_records_hemi),
by = c("vascan_species" = "species")) |>
arrange(speciesKey)
nrow(shared); n_distinct(shared$speciesKey)
print(shared, n = Inf)
# The worrying cases: pairs where the shared GBIF species links a native and an
# introduced VASCAN species, or a medicinal and a non-medicinal one
shared |>
group_by(speciesKey) |>
filter(n_distinct(status_in_region) > 1 | n_distinct(medicinal) > 1) |>
print(n = Inf)
n_peoples = n_distinct(people, na.rm = TRUE) -
(any(people == "Algonquians", na.rm = TRUE) &
any(language_family == "Algonquian" & people != "Algonquians", na.rm = TRUE)),
use_summary <- uses |>
inner_join(row_to_species, by = "row") |>
group_by(species = accepted_species) |>
summarise(
n_use_records    = n_distinct(paste(row, use_id)),
n_parts_used     = n_distinct(part_used, na.rm = TRUE),
# "Algonquians" counts as a people only if no named Algonquian people uses the species
n_peoples        = n_distinct(people, na.rm = TRUE) -
(any(people == "Algonquians", na.rm = TRUE) &
any(language_family == "Algonquian" & people != "Algonquians",
na.rm = TRUE)),
n_language_fam   = n_distinct(language_family[language_family %in%
c("Algonquian", "Athapaskan")]),
used_algonquian  = any(language_family == "Algonquian", na.rm = TRUE),
used_athapaskan  = any(language_family == "Athapaskan", na.rm = TRUE),
n_references     = n_distinct(ref, na.rm = TRUE),     # sampling effort
.groups = "drop")
