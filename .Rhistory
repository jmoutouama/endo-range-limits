# 2. Endophyte effect within Access plots, by species
desc_stats %>%
filter(Herbivory == "Access") %>%
group_by(Species, Endo) %>%
summarise(mean_damage = mean(HerbProp, na.rm=TRUE),
median_damage = median(HerbProp, na.rm=TRUE))
