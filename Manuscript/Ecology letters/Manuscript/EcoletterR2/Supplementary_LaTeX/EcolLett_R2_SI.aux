\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces Annual temperature (\ensuremath  {^\circ }C) during the 2024 and 2025 census years. Sites are arranged west to east by longitude.}}{18}{figure.caption.12}\protected@file@percent }
