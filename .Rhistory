# Helper function to compute loo
compute_loo <- function(fit) {
log_lik <- loo::extract_log_lik(fit, merge_chains = FALSE)
r_eff <- loo::relative_eff(exp(log_lik))
loo_result <- loo(log_lik, r_eff = r_eff, cores = 4)
plot(loo_result)
return(loo_result)
}
