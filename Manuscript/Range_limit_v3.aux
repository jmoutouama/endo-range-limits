\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:prediction}{{1}{27}{Conceptual framework illustrating predicted effects of abiotic stress, biotic stress, and symbiont-mediated mutualism on host plant fitness (adapted from \citealt {porter2020beneficial}). (A) Symbiont-driven stress amelioration: symbionts enhance host performance under increasing abiotic stress in the absence of herbivores. (B) Reduced symbiont benefits under combined abiotic and biotic stress due to host resource limitation. Blue lines represent symbiont-positive ($S^{+}$) and violet lines represent symbiont-negative ($S^{-}$) plants}{figure.caption.1}{}}
\citation{PRISM2024}
\citation{gbif2025_aghy,gbif2025_elvi,gbif2025_poau}
\citation{PRISM2024}
\citation{gbif2025_aghy,gbif2025_elvi,gbif2025_poau}
\newlabel{fig:site}{{2}{28}{Distribution of common garden sites along a natural aridity gradient from Texas to Louisiana, USA for (A) \emph {Agrostis hyemalis}, (B) \emph {Elymus virginicus}, and (C) \emph {Poa autumnalis}. Climate data in A--C are based on 30-year normals (1996--2025) from PRISM \citep {PRISM2024}, illustrating the precipitation gradient across experimental sites (scale bar in mm). Red dots indicate source population locations; grey dots represent GBIF occurrence records within the study area \citep {gbif2025_aghy,gbif2025_elvi,gbif2025_poau}. (D) Annual cumulative precipitation during census years (2024 and 2025) at each experimental site, ordered west to east, derived from PRISM climate data. (E) Schematic illustration of herbivore exclusion and herbivore access plots; `$S^{+}$' denotes symbiont-positive and `$S^{-}$' denotes symbiont-negative individuals. Equal numbers are shown for illustration, although symbiont frequencies varied among experimental plots. (F) Proportion of damaged plants in herbivore exclusion and herbivore access plots across experimental sites (mean $\pm $ SE). Species-specific breakdowns are provided in Supplementary Figs~\ref {sup:herb} and~\ref {sup:herbsp}}{figure.caption.2}{}}
\newlabel{fig:Surv}{{3}{29}{Predicted survival probability (upper panels) and symbiont effect ($\Delta = S^{+} - S^{-}$; lower panels) across the precipitation gradient. Lines show posterior means with 90\% credible intervals. Points indicate observed means, with point size proportional to sample size. Horizontal dashed line denotes $\Delta = 0$. Panels are arranged by species and herbivory treatment (herbivore access and exclusion). All panels share a common x-axis for illustrative purposes; some species extend beyond their observed precipitation range}{figure.caption.3}{}}
\newlabel{fig:growth}{{4}{30}{Predicted relative growth rate (upper panels) and symbiont effect ($\Delta = S^{+} - S^{-}$; lower panels) across the precipitation gradient. Lines show posterior means with 90\% credible intervals. Points indicate observed means, with point size proportional to sample size. Horizontal dashed line denotes $\Delta = 0$. Panels are arranged by species and herbivory treatment (herbivore access and exclusion). All panels share a common x-axis for illustrative purposes; some species extend beyond their observed precipitation range}{figure.caption.4}{}}
\newlabel{fig:inflo}{{5}{31}{Predicted inflorescence production (upper panels) and symbiont effect ($\Delta = S^{+} - S^{-}$; lower panels) across the precipitation gradient. Lines show posterior means with 90\% credible intervals. Points indicate observed values. Horizontal dashed line denotes $\Delta = 0$. Panels are arranged by species and herbivory treatment (herbivore access and exclusion). All panels share a common x-axis for illustrative purposes; some species extend beyond their observed precipitation range}{figure.caption.5}{}}
\newlabel{fig:biomass_inflo}{{6}{32}{Endophyte symbiont effects on plant performance vary with soil origin. Upper panels show observed values (points) and posterior fitted means with 50\% and 95\% credible intervals (filled circles and lines) for \textit {Agrostis hyemalis} grown in soils from seven sites spanning a precipitation gradient (wet to dry, left to right), for (A) aboveground biomass (g) and (B) total inflorescences per plant. Lower panels (C, D) show the posterior contrast (S$^{+}$ $-$ S$^{-}$) per soil origin site; dashed line indicates no effect. Point estimates are posterior medians; horizontal bars span 50\% and 95\% credible intervals. Colours denote symbiont status: endophyte-symbiotic (S$^{+}$, blue) and endophyte-free (S$^{-}$, red)}{figure.caption.6}{}}
\newlabel{tab:comp_table_driver}{{1}{33}{Comparison of models assessing the drivers of grass--symbiont symbiosis across four fitness components (vital rates). $\Delta $ELPD represents the difference in expected log predictive density relative to the best-fitting model, and SE denotes the standard error of this difference}{table.caption.7}{}}
\newlabel{sec:models}{{}{34}{}{table.caption.7}{}}
\newlabel{RF1}{37}
\newlabel{tab:source_pop}{{S1}{37}{Geographic coordinates and descriptions of source populations for study species. For each source population, the table shows the total number of plants included in the experiment, the number of unique genotypes, and the average clonal replication per genotype}{table.caption.8}{}}
\newlabel{tab:heat_treatment}{{S2}{38}{Summary of symbiont removal treatments by species and population. N indicates the number of plants tested for symbiont status and \%$S^{+}$ indicates the proportion that tested positive. Treatment refers to the symbiont removal treatment applied to the seed lineage: Control (no treatment) or Heat (5 days in a drying oven at 60\degree C for \emph {E. virginicus} and \emph {P. autumnalis};12 minutes in a 60\degree C water bath for \emph {A. hyemalis}). For all populations except SFAEF and PALM, heat-treated seed lineages were one or more generations removed from the treatment;for those two populations, plants from heat-treated seeds were used directly in the experiment}{table.caption.9}{}}
\newlabel{tab:exp_sites}{{S3}{39}{Common garden sites used for reciprocal transplant and environmental manipulation studies}{table.caption.10}{}}
\newlabel{tab:soil_pop}{{S4}{40}{Sample sizes for each combination of seed source population, soil-origin site, and endophyte treatment in the greenhouse experiment. The experiment crossed two seed source populations (LPEF and SJC), seven soil-origin sites along the precipitation gradient, and two symbiont treatments ($S^{-}$ and $S^{+}$). Most treatment combinations included seven replicates, except LPEF $\times $ BFL $\times $ $S^{-}$ where $n = 6$ due to early mortality}{table.caption.11}{}}
\newlabel{tab:model_comparison}{{S5}{41}{Comparison of candidate models (quadratic vs.\ linear) for each vital rate based on leave-one-out cross-validation (LOO-CV). $\Delta $ELPD is relative to the best model}{table.caption.12}{}}
\newlabel{tab:delta_summary_surv_quantiles}{{S6}{42}{Posterior summaries of $\Delta $ ($S^{+} - S^{-}$) for survival across precipitation quantiles (mm) for each species and herbivore treatment. Positive median values indicate beneficial effects of symbionts; negative medians indicate costly effects. $P(\Delta >0)$ quantifies the strength of evidence: values near 1 indicate strong support for a benefit, values near 0 indicate strong support for a cost, and values near 0.5 indicate little or no consistent effect. Herbivore treatment: Exclusion = herbivores excluded; Access = herbivores had access}{table.caption.13}{}}
\newlabel{tab:delta_summary_grow}{{S7}{43}{Posterior summaries of $\Delta $ ($S^{+} - S^{-}$) for growth across precipitation quantiles (mm) for each species and herbivore treatment. Positive median values indicate beneficial effects of symbionts;negative medians indicate costly effects. $P(\Delta >0)$ quantifies the strength of evidence: values near 1 indicate strong support for a benefit, values near 0 indicate strong support for a cost, and values near 0.5 indicate little or no consistent effect}{table.caption.14}{}}
\newlabel{tab:delta_summary_flow}{{S8}{44}{Posterior summaries of $\Delta $ ($S^{+} - S^{-}$) for inflorescence production across precipitation quantiles (mm) for each species and herbivore treatment. Positive median values indicate beneficial effects of symbionts;negative medians indicate costly effects. $P(\Delta >0)$ quantifies the strength of evidence: values near 1 indicate strong support for a benefit, values near 0 indicate strong support for a cost, and values near 0.5 indicate little or no consistent effect}{table.caption.15}{}}
\newlabel{tab:delta_summary_spike}{{S9}{45}{Posterior summaries of $\Delta $ ($S^{+} - S^{-}$) for spikelet production across precipitation quantiles (mm) for each species and herbivore treatment. Positive median values indicate beneficial effects of symbionts;negative medians indicate costly effects. $P(\Delta >0)$ quantifies the strength of evidence: values near 1 indicate strong support for a benefit, values near 0 indicate strong support for a cost, and values near 0.5 indicate little or no consistent effect}{table.caption.16}{}}
\newlabel{tab:posterior_soil}{{S10}{46}{Posterior summaries of the interaction between endophyte presence (S$^+$) and source population (Site) for each fitness component. For each model, the table reports the median estimate, 95\% credible interval (Lower and Upper), and the posterior probability that the effect is greater than zero (P($>0$))}{table.caption.17}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {S.0.1}Supporting Figures}{47}{subsection.Alph0.1}\protected@file@percent }
\newlabel{sup:temp}{{S1}{47}{Annual temperature (\degree C) during the 2024 and 2025 census years. Sites are arranged west to east by longitude}{figure.caption.18}{}}
\newlabel{sup:herb}{{S2}{48}{Proportion of plants damaged by herbivory across sites in 2024 and 2025. Barplots show fenced (dark) versus unfenced (grey) plots for each site (ordered west to east). Error bars indicate standard errors across plots within each site. Panels show results for 2024 (left) and 2025 (right)}{figure.caption.19}{}}
\newlabel{sup:herbsp}{{S3}{49}{Proportion of plants damaged by herbivory across sites for \textit {Agrostis hyemalis}, \textit {Elymus virginicus}, and \textit {Poa autumnalis} over 2023--2025. Barplots show fenced (grey80) versus unfenced (grey15) proportions for each site (ordered west to east: SON, KER, BFL, BAS, COL, HUN, LAF). Error bars indicate standard errors across plots within each site. Panels are arranged by species (rows) and year (columns)}{figure.caption.20}{}}
\newlabel{sup:ppc_vital}{{S4}{50}{Posterior predictive checks for each vital rate. Dark blue lines show observed data ($y$) and light blue lines show replicated datasets from posterior predictions ($y_{\text {rep}}$). Strong overlap across survival, growth, inflorescence, and spikelet production indicates adequate model fit for all vital rates}{figure.caption.21}{}}
\newlabel{sup:ppc_models_soil}{{S5}{51}{Posterior predictive checks for Bayesian models of plant performance in the greenhouse experiment. Density overlays show observed data (solid line) and 200 posterior predictive draws (shaded lines) for (A) aboveground biomass, (B) inflorescence count, and (C) average spikelets per plant. Models adequately capture the distribution of observed data across all response variables}{figure.caption.22}{}}
\newlabel{sup:spikelet}{{S6}{52}{Predicted spikelet production (upper panels) and symbiont effect ($\Delta = S^{+} - S^{-}$; lower panels) across the precipitation gradient. Lines show posterior means with 90\% credible intervals. Points represent mean observed spikelets per plot, slightly jittered for visualization. Spikelets were measured for two species only (see Methods). The dashed line at $\Delta = 0$ indicates no symbiont effect. Panels are arranged by species and herbivory treatment (herbivore access and exclusion). All panels share a common x-axis for illustrative purposes; some species extend beyond their observed precipitation range}{figure.caption.23}{}}
\newlabel{sup:spike_delta}{{S7}{53}{Median $\Delta $ ($S^{+} - S^{-}$) and posterior probability $P(\Delta > 0)$ for spikelet production across precipitation quantiles for each species and herbivory treatment. Herbivore exclusion treatments are indicated by colour (Fenced = herbivores excluded; Unfenced = herbivores had access). Horizontal dashed lines indicate $\Delta = 0$ for medians and $P(\Delta > 0) = 0.5$ for probabilities. Panels are arranged by metric and species}{figure.caption.24}{}}
\newlabel{sup:allstat}{{S8}{54}{Median $\Delta $ ($S^{+} - S^{-}$) and $P(\Delta > 0)$ for survival, growth, and inflorescence production across the precipitation gradient. Horizontal dashed lines denote $\Delta = 0$ and $P(\Delta > 0) = 0.5$. Panels are arranged by species and vital rate}{figure.caption.25}{}}
