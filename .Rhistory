) %>%
na.omit() %>%
mutate(
Site = as.integer(factor(Site)),
site_year=as.integer(factor(site_year)),
Species = as.integer(factor(Species)),
Population = as.integer(factor(Population)),
site_species_plot = as.integer(factor(site_species_plot)),
