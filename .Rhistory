N <- 4
M <- sim_acor_matrix(N, rho_row = 0.5, rho_col = 0.5)
df <- mat_to_df(M)
# ---- Plot with thin white borders ----
ggplot(df, aes(x = col, y = row, fill = value)) +
geom_tile(color = "white", linewidth = 0.3) +
scale_y_reverse() +
coord_fixed(expand = FALSE) +
scale_fill_gradient2(
low = "cornflowerblue", mid = "lightgray", high = "tomato",
midpoint = 0,
limits = c(-max(abs(df$value), na.rm = TRUE),
max(abs(df$value), na.rm = TRUE)),
oob = scales::squish
) +
theme_void() +
theme(
legend.position = "none",
plot.margin = margin(0, 0, 0, 0)
)
