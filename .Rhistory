# ─────────────────────────────────────────────────────────────────────────────
# 12.  FIGURE 5 — GDD TRENDS  (network-averaged, not per LID)
# ─────────────────────────────────────────────────────────────────────────────
gdd_annual_sites <- clim_monthly %>%
left_join(days_per_month, by = "Month") %>%
mutate(
Tave_capped = pmin(Tave, UPPER_TEMP, na.rm = TRUE),
GDD_month   = pmax(0, Tave_capped - BASE_TEMP, na.rm = TRUE) * days_in_m
) %>%
group_by(LID, Year) %>%
summarize(GDD_ann = sum(GDD_month, na.rm = TRUE), .groups = "drop") %>%
inner_join(distinct(lid_species, LID, SpeciesName), by = "LID")
# Network mean GDD per year
network_gdd <- gdd_annual_sites %>%
group_by(Year) %>%
summarize(GDD_mean = mean(GDD_ann, na.rm = TRUE),
GDD_sd   = sd(GDD_ann,   na.rm = TRUE),
n        = n(), .groups = "drop") %>%
filter(n >= 5)
# Species mean GDD per year
species_gdd <- gdd_annual_sites %>%
group_by(SpeciesName, Year) %>%
summarize(GDD_mean = mean(GDD_ann, na.rm = TRUE),
.groups  = "drop")
fig5a <- ggplot(network_gdd, aes(x = Year)) +
geom_ribbon(aes(ymin = GDD_mean - GDD_sd, ymax = GDD_mean + GDD_sd),
fill = "#E67E22", alpha = 0.18) +
geom_line(aes(y = GDD_mean), colour = "#CA6F1E", linewidth = 0.9) +
geom_smooth(aes(y = GDD_mean, group = 1),
method = "loess", span = 0.35,
colour = "#7D3C98", fill = "#7D3C98",
alpha = 0.20, linewidth = 1.2) +
scale_x_continuous(breaks = seq(1940, 2025, 20)) +
labs(x = "Year",
y = paste0("Annual GDD (base ", BASE_TEMP, "°C)"),
title = "A  Network-wide GDD trend",
subtitle = "Line = network mean  |  Ribbon = ±1 SD  |  Purple LOESS = long-term trend") +
theme_pub()
fig5a
# Historical (≤1970) vs recent (≥1991) GDD by species
gdd_era <- gdd_annual_sites %>%
mutate(Era = case_when(
Year <= 1970 ~ "Historical (1931–1970)",
Year >= 1991 ~ "Recent (1991–2025)",
TRUE         ~ NA_character_
)) %>%
filter(!is.na(Era))
gdd_era
fig5b <- ggplot(gdd_era,
aes(x = GDD_ann,
y = reorder(SpeciesName, GDD_ann, median),
fill = Era)) +
geom_density_ridges(alpha = 0.65, scale = 0.9,
quantile_lines = TRUE, quantiles = 2) +
scale_fill_manual(values = c("Historical (1931–1970)" = "#4E79A7",
"Recent (1991–2025)"    = "#E15759"),
name = NULL) +
labs(x = paste0("Annual GDD (base ", BASE_TEMP, "°C)"),
y = NULL,
title = "B  GDD distributional shift: historical vs. recent") +
theme_pub() +
theme(axis.text.y = element_text(face = "italic"),
legend.position = "top")
fig5b
fig5 <- (fig5a / fig5b) +
plot_annotation(
title    = "Figure 5. Growing degree day trends across the plantation network",
subtitle = paste0(
"GDD = max(0, min(T_ave, ", UPPER_TEMP, ") - ", BASE_TEMP, ") × days_per_month\n",
"Sources: McMaster & Wilhelm (1997); Louw et al. (2011); Way & Oren (2010)"
),
tag_levels = "A"
)
fig5
