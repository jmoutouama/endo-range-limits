# --- Figure 2: Mismatch vs growth by species ---
p2 <- ggplot(
sa_growth_life,
aes(x = temp_mismatch, y = Htd_z, color = Age)
) +
geom_point(alpha = 0.2, size = 0.6) +
geom_smooth(method  = "lm",
formula = y ~ x + I(x^2),
color   = "black",
linewidth = 1, se = TRUE) +
facet_wrap(~Species, scales = "free_y") +
scale_color_viridis_c(option = "plasma",
name   = "Age (years)") +
labs(
x        = "Temperature mismatch (degrees C)",
y        = "Dominant height (z-scored)",
title    = "Raw relationship: climate debt vs growth",
subtitle = "Black = quadratic OLS; points coloured by age"
) +
theme_classic(base_size = 12)
