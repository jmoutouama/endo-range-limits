# Load packages
library(tidyverse)  # for data manipulation and ggplot
library(broom)      # to tidy model outputs
# Example dataframe structure (replace with your real data)
your_data <- data.frame(
Species = factor(rep(c("A", "B", "C"), each=40)),
Endophyte = factor(rep(c("E+", "E-"), each=20, times=3)),
Survival = sample(0:1, 120, replace=TRUE),
Growth = rnorm(120, 10, 3),
Flowering = sample(0:1, 120, replace=TRUE),
Spikelet = rpois(120, lambda=20)
)
your_data
# Your aggregated data
your_data <- data.frame(
Species = factor(rep(c("A", "B", "C"), each=2)),
Endophyte = factor(rep(c("E+", "E-"), times=3)),
Survival = c(0.8, 0.5, 0.9, 0.6, 0.7, 0.4),
Growth = c(12.3, 8.1, 15.0, 9.4, 13.5, 7.5),
Flowering = c(0.7, 0.3, 0.8, 0.4, 0.6, 0.2),
Spikelet = c(45, 30, 50, 35, 40, 25)
)
your_data
# PCA on the numeric variables
pca <- prcomp(your_data[, c("Survival", "Growth", "Flowering", "Spikelet")], scale. = TRUE)
pca
# View PCA summary
summary(pca)
# Add PCA scores to data
your_data$PC1 <- pca$x[,1]
your_data$PC2 <- pca$x[,2]
# Plot PCA scores colored by Endophyte, shaped by Species
library(ggplot2)
ggplot(your_data, aes(x = PC1, y = PC2, color = Endophyte, shape = Species)) +
geom_point(size = 4) +
theme_minimal() +
labs(title = "PCA of aggregated variables by Species and Endophyte",
x = "PC1",
y = "PC2")
ggplot(your_data, aes(x = PC1, y = PC2, color = Endophyte, fill = Endophyte)) +
geom_point(size = 4, shape = 21, stroke = 1.5) +
geom_density_2d(alpha = 0.7, size = 1) +            # density contours
# Or for filled contours (uncomment next line and comment previous)
# geom_density_2d_filled(alpha = 0.3) +
scale_color_manual(values = c("E+" = "blue", "E-" = "red")) +
scale_fill_manual(values = c("E+" = "blue", "E-" = "red")) +
theme_minimal() +
labs(title = "PCA of Species × Endophyte with Kernel Density",
x = "PC1", y = "PC2")
# Reshape to long format for plotting
long_data <- your_data %>%
pivot_longer(cols = c(Survival, Growth, Flowering, Spikelet),
names_to = "Trait", values_to = "Value")
ggplot(long_data, aes(x = Endophyte, y = Value, group = Species, color = Species)) +
geom_point(size = 4) +
geom_line(aes(group = Species), size = 1) +
facet_wrap(~Trait, scales = "free_y") +
theme_minimal() +
labs(title = "Comparison of E+ and E- by Species across traits")
