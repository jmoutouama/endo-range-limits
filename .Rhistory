# ─────────────────────────────────────────────────────────────────────────────
# 15.  FIGURE S1 — SPEI SUPPLEMENTARY
# ─────────────────────────────────────────────────────────────────────────────
mid_month_doy <- c(15, 46, 74, 105, 135, 166, 196, 227, 258, 288, 319, 349)
compute_site_spei <- function(site_data) {
site_data <- site_data %>% arrange(Year, Month)
n <- nrow(site_data)
if (n < 6) return(tibble(Year = site_data$Year, Month = site_data$Month,
SPEI3 = NA_real_))
lat_rad <- mean(site_data$Latitude, na.rm = TRUE) * pi / 180
doy  <- mid_month_doy[site_data$Month]
dr   <- 1 + 0.033 * cos(2 * pi * doy / 365)
d    <- 0.409 * sin(2 * pi * doy / 365 - 1.39)
ws   <- acos(pmax(-1, pmin(1, -tan(lat_rad) * tan(d))))
Ra   <- pmax(0, (24 * 60 / pi) * 0.082 * dr *
(ws * sin(lat_rad) * sin(d) +
cos(lat_rad) * cos(d) * sin(ws)))
dm   <- days_per_month$days_in_m[site_data$Month]
TD   <- pmax(0, site_data$Tmax - site_data$Tmin, na.rm = TRUE)
PET  <- pmax(0, 0.0023 * Ra * dm * sqrt(TD) * (site_data$Tave + 17.8))
WB   <- site_data$PPT - PET
WB3  <- zoo::rollsum(WB, 3, fill = NA, align = "right")
SPEI3 <- if (sum(!is.na(WB3)) >= 6 && sd(WB3, na.rm = TRUE) > 0)
as.numeric(scale(WB3)) else rep(NA_real_, n)
tibble(Year = site_data$Year, Month = site_data$Month, SPEI3 = SPEI3)
}
spei_monthly <- purrr::map_dfr(unique(clim_monthly$LID), function(lid) {
d <- clim_monthly %>%
filter(LID == lid) %>%
left_join(days_per_month, by = "Month")
tryCatch(
compute_site_spei(d) %>% mutate(LID = lid),
error = function(e) tibble(Year = d$Year, Month = d$Month,
SPEI3 = NA_real_, LID = lid)
)
})
spei_net <- spei_monthly %>%
inner_join(distinct(lid_species, LID), by = "LID") %>%
group_by(Year) %>%
summarize(SPEI3_mean = mean(SPEI3, na.rm = TRUE),
SPEI3_sd   = sd(SPEI3,   na.rm = TRUE),
n          = n(), .groups = "drop") %>%
filter(n >= 5)
figS1 <- ggplot(spei_net, aes(x = Year)) +
geom_hline(yintercept =  0, colour = "grey60", linewidth = 0.4) +
geom_hline(yintercept = -1, colour = "#C0392B", linetype = "dashed",
linewidth = 0.5) +
geom_ribbon(aes(ymin = SPEI3_mean - SPEI3_sd,
ymax = SPEI3_mean + SPEI3_sd),
fill = "#3498DB", alpha = 0.18) +
geom_line(aes(y = SPEI3_mean), colour = "#2471A3", linewidth = 0.9) +
geom_smooth(aes(y = SPEI3_mean, group = 1),
method = "loess", span = 0.35,
colour = "#922B21", fill = "#922B21",
alpha = 0.20, linewidth = 1.2) +
scale_x_continuous(breaks = seq(1940, 2025, 20)) +
labs(x = "Year", y = "Mean SPEI-3",
title    = "Figure S1. Network-wide SPEI-3 drought index (1931–2025)",
subtitle = paste0(
"No consistent directional trend detected — drought not the primary driver\n",
"Red dashed = moderate drought threshold (SPEI-3 < −1)\n",
"Vicente-Serrano et al. (2010)  |  PET: Hargreaves & Samani (1985)"
)) +
theme_pub()
figS1
# Complete cases only
stan_df <- sa_full %>%
select(Htm, Age_z, GDD_site_mean_z, GDD_deviation_z,
Rad_index_z, TPI_macro_z, LID, SpeciesName) %>%
filter(complete.cases(.)) %>%
mutate(
# Integer indices for Stan
site_id    = as.integer(factor(LID)),
species_id = as.integer(factor(SpeciesName))
)
# Species and site lookup tables (for post-processing posterior)
species_lookup <- stan_df %>%
distinct(species_id, SpeciesName) %>%
arrange(species_id)
