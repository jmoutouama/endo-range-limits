species_traits <- read_csv(file.path(data_dir, "species_traits.csv"), show_col_types = FALSE) %>%
mutate(Species_key = str_replace_all(Species, " ", "_"))
# NOTE: Simmondsia chinensis is now present in the CSV; add_row() removed.
# Confirm all species are covered
missing_after <- effect_sizes_model_ready %>%
distinct(Species) %>%
anti_join(species_traits, by = c("Species" = "Species_key"))
cat(sprintf("Unmatched species after join: %d\n", nrow(missing_after)))
# Should print: Unmatched species after join: 0
data_joined <- effect_sizes_model_ready %>%
left_join(species_traits %>% select(Species_key, growth_form, dispersal,
pollination_mode_A, pollination_mode_B, pollination_mode_AB, Plant_height_m, Clonal),
by = c("Species" = "Species_key"))
# Confirm zero NAs after join
stopifnot(sum(is.na(data_joined$growth_form)) == 0)
# Report pollination coverage per rater -- NA rows are silently dropped
# by the corresponding model_pollen_* below
for (col in c("pollination_mode_A", "pollination_mode_B", "pollination_mode_AB")) {
cat(sprintf(
"%s coverage: %d / %d rows have data (%.0f%%)\n",
col,
sum(!is.na(data_joined[[col]])),
nrow(data_joined),
100 * mean(!is.na(data_joined[[col]]))
))
}
data_joined <- data_joined %>%
mutate(dispersal_binary = case_when(dispersal == "Animal" ~ "Zoochory",
dispersal == "Wind"   ~ "Anemochory", dispersal == "Water"  ~ "Hydrochory",
TRUE ~ NA_character_), growth_form_simple = case_when(growth_form == "Tree"  ~ "Tree",
growth_form == "Shrub" ~ "Shrub", growth_form == "Herb"  ~ "Herbaceous",
growth_form == "Grass" ~ "Herbaceous", TRUE ~ NA_character_),
# Rater A and Rater B never record "Both" (each is one person's single
# call), so their pollen_simple factors have only two levels. The
# reconciled AB column can be "Both" -> "Mixed", so it keeps three.
pollen_simple_A = case_when(pollination_mode_A == "Wind"   ~ "Wind",
pollination_mode_A == "Animal" ~ "Zoophily", TRUE ~ NA_character_),
pollen_simple_B = case_when(pollination_mode_B == "Wind"   ~ "Wind",
pollination_mode_B == "Animal" ~ "Zoophily", TRUE ~ NA_character_),
pollen_simple_AB = case_when(pollination_mode_AB == "Wind"   ~ "Wind",
pollination_mode_AB == "Animal" ~ "Zoophily", pollination_mode_AB == "Both"   ~ "Mixed",
TRUE ~ NA_character_), growth_form_simple = factor(growth_form_simple,
levels = c("Tree", "Shrub", "Herbaceous")),
dispersal_binary   = factor(dispersal_binary,
levels = c("Anemochory", "Zoochory", "Hydrochory")),  # 3 levels: 3 species (Hippophae rhamnoides, Laguncularia racemosa, Populus euphratica) are water-dispersed
pollen_simple_A    = factor(pollen_simple_A,  levels = c("Wind", "Zoophily")),
pollen_simple_B    = factor(pollen_simple_B,  levels = c("Wind", "Zoophily")),
pollen_simple_AB   = factor(pollen_simple_AB, levels = c("Wind", "Zoophily", "Mixed")))
stopifnot(sum(is.na(data_joined$growth_form_simple)) == 0)
stopifnot(sum(is.na(data_joined$dispersal_binary))   == 0)
stopifnot(all(is.na(data_joined$pollen_simple_A))  == is.na(data_joined$pollination_mode_A))
stopifnot(all(is.na(data_joined$pollen_simple_B))  == is.na(data_joined$pollination_mode_B))
stopifnot(all(is.na(data_joined$pollen_simple_AB)) == is.na(data_joined$pollination_mode_AB))
cat("=== Group sizes for moderator models ===\n")
data_joined %>% count(growth_form_simple, dispersal_binary) %>% print(n = Inf)
# Chunk 45
# How big is data_joined itself, and how does it compare to the 362?
nrow(data_joined)
data_joined %>%
count(pollen_simple_AB, sort = TRUE) %>%
print(n = Inf)
cat(sprintf("\nRows with NA pollen_simple_AB: %d\n",
sum(is.na(data_joined$pollen_simple_AB))))
# Chunk 46
effect_sizes_model_ready %>%
filter(response_category %in% c("Survival", "Abundance")) %>%
group_by(response_category) %>%
summarise(k = n(), Studies = n_distinct(Study_ID), Species = n_distinct(Species))
data_joined %>%
filter(pollen_simple_AB == "Mixed") %>%
summarise(k = n(), Studies = n_distinct(Study_ID), Species = n_distinct(Species))
# Confirm the actual exclusion reason (should show n_studies < 3 for
# Survival, Abundance, and Belowground; >=3 for the six retained categories)
effect_sizes_model_ready %>%
group_by(response_category) %>%
summarise(n_studies = n_distinct(Study_ID)) %>%
arrange(n_studies)
# Chunk 47: life-history-sex-data
# Life-history models use the same sex-specific data and model as Section 15
# (sex as a fixed effect), so every figure shows the female, male and
# combined response. The traits come from data_joined, one row per species.
life_history_cols <- data_joined %>%
distinct(Species, growth_form_simple, dispersal_binary, pollen_simple_A, pollen_simple_B,
pollen_simple_AB, Clonal, Plant_height_m)
stopifnot("A species has more than one life-history row" =
!any(duplicated(life_history_cols$Species)))
sex_joined <- effect_sizes_sex_ready %>%
left_join(life_history_cols, by = "Species") %>%
mutate(log_height = log(Plant_height_m))
stopifnot("Life-history traits missing for a species in the sex-specific data" =
!anyNA(sex_joined$growth_form_simple), !anyNA(sex_joined$dispersal_binary))
# rows with a missing moderator are dropped, and unused factor levels with them
fit_sex_life_history <- function(moderator, name) {
dat <- sex_joined %>% filter(!is.na(.data[[moderator]])) %>% droplevels()
fit_sex_model(paste0("0 + Sex:", moderator), dat, name)
}
cat("=== Sex-specific rows per life-history level ===\n")
for (v in c("growth_form_simple", "dispersal_binary", "pollen_simple_A", "pollen_simple_B",
"pollen_simple_AB", "Clonal")) {
sex_joined %>%
filter(!is.na(.data[[v]])) %>%
group_by(level = .data[[v]]) %>%
summarise(k = n(), n_studies = n_distinct(Study_ID), n_species = n_distinct(Species),
.groups = "drop") %>%
mutate(moderator = v, .before = level) %>%
print()
}
# Chunk 48: model-life-history-sex
model_sex_growthform <- fit_sex_life_history("growth_form_simple", "model_sex_growthform")
model_sex_dispersal  <- fit_sex_life_history("dispersal_binary",   "model_sex_dispersal")
# pollen vector: rater A, rater B and the reconciled call, as before
model_sex_pollen_A   <- fit_sex_life_history("pollen_simple_A",    "model_sex_pollen_A")
model_sex_pollen_B   <- fit_sex_life_history("pollen_simple_B",    "model_sex_pollen_B")
model_sex_pollen_AB  <- fit_sex_life_history("pollen_simple_AB",   "model_sex_pollen_AB")
model_sex_clonal     <- fit_sex_life_history("Clonal",             "model_sex_clonal")
# plant height: one slope per sex
model_sex_height <- fit_sex_model("0 + Sex + Sex:log_height",
filter(sex_joined, !is.na(log_height)), "model_sex_height")
# Chunk 49: life-history-sex-summary
sex_draws_growthform <- sex_response_draws(model_sex_growthform, "growth_form_simple")
sex_draws_dispersal  <- sex_response_draws(model_sex_dispersal,  "dispersal_binary")
sex_draws_pollen_A   <- sex_response_draws(model_sex_pollen_A,   "pollen_simple_A")
sex_draws_pollen_B   <- sex_response_draws(model_sex_pollen_B,   "pollen_simple_B")
sex_draws_pollen_AB  <- sex_response_draws(model_sex_pollen_AB,  "pollen_simple_AB")
sex_draws_clonal     <- sex_response_draws(model_sex_clonal,     "Clonal") %>%
mutate(level = recode(level, "Yes" = "Clonal", "No" = "Non-clonal"))
sex_life_history_summary <- bind_rows(
sex_response_table(sex_draws_growthform, "Growth form"),
sex_response_table(sex_draws_dispersal,  "Dispersal mode"),
sex_response_table(sex_draws_pollen_A,   "Pollen vector (rater A)"),
sex_response_table(sex_draws_pollen_B,   "Pollen vector (rater B)"),
sex_response_table(sex_draws_pollen_AB,  "Pollen vector (reconciled)"),
sex_response_table(sex_draws_clonal,     "Clonality"))
cat("=== Sex-specific stress response by life history ===\n")
print(sex_life_history_summary, n = Inf, width = Inf)
write_csv(sex_life_history_summary, file.path(output_dir, "sex_specific_life_history_summary.csv"))
# height: slope of the stress response on log(height), per sex, combined,
# and the female - male difference in slope
height_slopes <- as_draws_df(model_sex_height) %>%
transmute(Female = `b_Sexfemale:log_height`, Male = `b_Sexmale:log_height`,
Combined = (Female + Male) / 2, `Female - Male` = Female - Male) %>%
pivot_longer(everything(), names_to = "term", values_to = ".value") %>%
group_by(term) %>%
summarise(slope = sprintf("%.2f [%.2f, %.2f]", median(.value), quantile(.value, 0.025),
quantile(.value, 0.975)), p_gt0 = round(mean(.value > 0), 3), .groups = "drop")
cat("\n=== Slope of the stress response on log(plant height) ===\n")
print(height_slopes)
write_csv(height_slopes, file.path(output_dir, "sex_specific_height_slopes.csv"))
# Chunk 50: figure-life-history-sex
# rows: growth form, dispersal mode, pollen vector (reconciled), clonality
fig_traits <- (sex_panel(sex_draws_growthform, "(a)") | contrast_panel(sex_draws_growthform, "(b)")) /
(sex_panel(sex_draws_dispersal, "(c)") | contrast_panel(sex_draws_dispersal, "(d)")) /
(sex_panel(sex_draws_pollen_AB, "(e)") | contrast_panel(sex_draws_pollen_AB, "(f)")) /
(sex_panel(sex_draws_clonal, "(g)") | contrast_panel(sex_draws_clonal, "(h)")) +
plot_layout(guides = "collect", heights = c(1, 1, 1, 0.75)) & theme(legend.position = "top")
fig_traits
ggsave(file.path(fig_dir, "Figure_life_history_moderators.pdf"), plot = fig_traits,
device = cairo_pdf, width = 173, height = 230, units = "mm")
ggsave(file.path(fig_dir, "Figure_life_history_moderators.tiff"), plot = fig_traits,
device = "tiff", width = 173, height = 230, units = "mm", dpi = 600, compression = "lzw")
# Chunk 51: figure-pollen-raters-sex
# pollen vector by classification source: rater A, rater B, reconciled
fig_pollen_raters <- (sex_panel(sex_draws_pollen_A, "(a) Rater A") | contrast_panel(sex_draws_pollen_A, "(b)")) /
(sex_panel(sex_draws_pollen_B, "(c) Rater B") | contrast_panel(sex_draws_pollen_B, "(d)")) /
(sex_panel(sex_draws_pollen_AB, "(e) Reconciled") | contrast_panel(sex_draws_pollen_AB, "(f)")) +
plot_layout(guides = "collect", heights = c(0.8, 0.8, 1)) & theme(legend.position = "top")
fig_pollen_raters
ggsave(file.path(fig_dir, "Figure_pollen_raters.pdf"), plot = fig_pollen_raters,
device = cairo_pdf, width = 173, height = 190, units = "mm")
ggsave(file.path(fig_dir, "Figure_pollen_raters.tiff"), plot = fig_pollen_raters,
device = "tiff", width = 173, height = 190, units = "mm", dpi = 600, compression = "lzw")
# Chunk 52: save-outputs
# Save cleaned effect size dataset and all posterior summary tables.
# The effect size CSV is included as supplementary material.
write_csv(effect_sizes_model_ready, file.path(output_dir, "effect_sizes_final.csv"))
write_csv(effect_sizes_sex_ready, file.path(output_dir, "effect_sizes_sex_specific_final.csv"))
write_csv(effect_sizes_sexratio_ready, file.path(output_dir, "effect_sizes_sex_ratio_final.csv"))
# Posterior tables, one per model family:
#   sex_specific_posterior_summary.csv   -- MAIN: female and male responses + F - M
#   sex_specific_sensitivity.csv         -- sensitivity of the sex model
#   sex_ratio_posterior_summary.csv      -- sex ratio by stressor
#   sex_difference_posterior_summary.csv -- comparison: effect-size-level difference
write_csv(heterogeneity_table, file.path(output_dir, "heterogeneity_table.csv"))
# Written inside their own chunks, listed here for reference:
#   sex_specific_setting_summary.csv      -- female, male, combined per setting
#   sex_specific_life_history_summary.csv -- same, per life-history level
#   sex_specific_pairwise_contrasts.csv   -- pairwise contrasts between levels
#   sex_specific_year_slopes.csv          -- year trends per sex
#   sex_specific_completeness.csv         -- raw vs converted effect sizes
message("All outputs saved to: ", output_dir)
# Chunk 53: sensitivity-completeness
# SENSITIVITY ANALYSIS -- Lajeunesse (2013) recommendation
# Do effect sizes converted from reported statistics behave differently
# from the ones I computed from means, SDs and sample sizes? Same sex model,
# with data completeness as the moderator. The converted group is small, so
# I print the sample sizes next to the estimates.
sex_completeness <- effect_sizes_sex_ready %>%
mutate(data_completeness = case_when(
effect_size_type %in% c("Treatment_sex_diff_g", "Treatment_sex_diff_g_categorical",
"Gradient_r_to_g", "Unpaired_gradient_r_diff_to_g") ~ "Complete_raw",
effect_size_type %in% c("Reported_r_to_g", "Slope_to_g") ~ "Converted",
TRUE ~ NA_character_)) %>%
filter(!is.na(data_completeness))
cat("=== Sex-specific rows by completeness group ===\n")
sex_completeness %>%
group_by(data_completeness, effect_size_type) %>%
summarise(rows = n(), contrasts = n_distinct(pair_id), n_studies = n_distinct(Study_ID),
.groups = "drop") %>%
print(n = Inf)
model_sex_completeness <- fit_sex_model("0 + Sex:data_completeness", sex_completeness,
"model_sex_completeness")
sex_draws_completeness <- sex_response_draws(model_sex_completeness, "data_completeness")
sex_completeness_summary <- sex_response_table(sex_draws_completeness, "Data completeness")
cat("\n=== Stress response by data completeness ===\n")
print(sex_completeness_summary, n = Inf, width = Inf)
print(sex_pairwise(sex_draws_completeness, "Data completeness"), width = Inf)
write_csv(sex_completeness_summary, file.path(output_dir, "sex_specific_completeness.csv"))
p_sensitivity <- sex_completeness %>%
ggplot(aes(x = yi_sex, fill = data_completeness, colour = data_completeness)) +
geom_density(alpha = 0.35, linewidth = 0.6) +
geom_vline(xintercept = 0, linetype = "dashed", colour = "grey30", linewidth = 0.4) +
scale_fill_manual(name = "Data completeness",
values = c("Complete_raw" = OI$blue, "Converted" = OI$red)) +
scale_colour_manual(name = "Data completeness",
values = c("Complete_raw" = OI$blue, "Converted" = OI$red)) +
scale_x_continuous(name = expression(paste("Stress response (Hedges' ", italic(g), ")")),
limits = c(-5, 5)) +
scale_y_continuous(name = "Density") +
theme_el +
theme(legend.position = "top")
p_sensitivity
ggsave(file.path(fig_dir, "Figure_sensitivity_completeness.tiff"), plot = p_sensitivity,
device = "tiff", width = 110, height = 90, units = "mm", dpi = 600, compression = "lzw")
# Chunk 54: baseline-control-data
# -- Pathway A2: control arm -------------------------------------------
baseline_A2 <- meta_data_categorical %>%
filter(Env_treatment %in% treatment_contrast_pairs$baseline_condition) %>%
group_by(Study_ID, Species, Response_var,
Env_treatment, Env_var_type, Setting, setting_category, Country,
stressor_type, response_category, Kingdom, negative_scale_correction) %>%
summarise(Xf             = mean(Xf,             na.rm = TRUE),
Xm             = mean(Xm,             na.rm = TRUE),
SD_female_used = mean(SD_female_used, na.rm = TRUE),
SD_male_used   = mean(SD_male_used,   na.rm = TRUE),
N_f            = mean(N_f,            na.rm = TRUE),
N_m            = mean(N_m,            na.rm = TRUE), .groups        = "drop") %>%
mutate(across(c(Xf, Xm, SD_female_used, SD_male_used, N_f, N_m), ~ na_if(., NaN))) %>%
# In the additional compilation one control group can serve several
# contrasts (Control_1, Control_2, ...). I keep it once.
distinct(Study_ID, Species, Response_var, Xf, Xm, SD_female_used, SD_male_used, N_f, N_m,
.keep_all = TRUE) %>%
rowwise() %>%
mutate(es = list(hedges_g_two_groups(Xf, SD_female_used, N_f, Xm, SD_male_used,   N_m)),
yi_raw           = es$yi, vi               = es$vi,
yi               = if (!is.na(yi_raw)) yi_raw * negative_scale_correction else NA_real_,
sei              = if (!is.na(vi) & vi > 0) sqrt(vi) else NA_real_,
effect_size_type = "Baseline_control_g") %>%
ungroup() %>%
filter(!is.na(yi), !is.na(vi), vi > 0) %>%
select(Study_ID, Species, Response_var, Setting, setting_category, Country,
stressor_type, response_category, yi, vi, sei, effect_size_type)
# -- Pathway A1: lowest-stress observation on continuous gradients ------
baseline_A1 <- meta_data_means %>%
filter(!is.na(env_value_numeric)) %>%
left_join(stress_direction_lookup, by = "Env_var_type") %>%
filter(!is.na(stress_direction)) %>%
group_by(Study_ID, Species, Response_var, Env_var_type, stressor_type, response_category,
Setting, setting_category, Country, stress_direction, negative_scale_correction) %>%
slice_min(order_by  = if_else(stress_direction == 1, env_value_numeric, -env_value_numeric),
n         = 1, with_ties = FALSE) %>%
ungroup() %>%
filter(!is.na(Xf), !is.na(Xm), !is.na(SD_female_used), !is.na(SD_male_used),
!is.na(N_f), !is.na(N_m)) %>%
rowwise() %>%
mutate(es = list(hedges_g_two_groups(Xf, SD_female_used, N_f, Xm, SD_male_used,   N_m)),
yi_raw           = es$yi, vi               = es$vi,
yi               = if (!is.na(yi_raw)) yi_raw * negative_scale_correction else NA_real_,
sei              = if (!is.na(vi) & vi > 0) sqrt(vi) else NA_real_,
effect_size_type = "Baseline_gradient_g") %>%
ungroup() %>%
filter(!is.na(yi), !is.na(vi), vi > 0) %>%
select(Study_ID, Species, Response_var, Setting, setting_category, Country,
stressor_type, response_category, yi, vi, sei, effect_size_type)
# -- Sex ratio: logit-transformed proportion female at control level ----
# Sex ratio baseline from categorical control arm only
baseline_sexratio <- meta_data_categorical %>%
filter(Env_treatment %in% treatment_contrast_pairs$baseline_condition,
response_category == "Sex_ratio", !is.na(M), !is.na(F)) %>%
mutate(n_total     = M + F, prop_female = F / n_total) %>%
filter(n_total > 0, prop_female > 0, prop_female < 1) %>%
group_by(Study_ID, Species, Response_var, stressor_type, response_category,
Setting, setting_category, Country) %>%
summarise(prop_female = weighted.mean(prop_female, n_total, na.rm = TRUE),
n_total     = sum(n_total, na.rm = TRUE), .groups     = "drop") %>%
mutate(yi               = log(prop_female / (1 - prop_female)),
vi               = 1 / (n_total * prop_female * (1 - prop_female)), sei              = sqrt(vi),
effect_size_type = "Baseline_sexratio_logit") %>%
filter(!is.na(yi), !is.na(vi), vi > 0, sei <= 10) %>%
select(Study_ID, Species, Response_var, Setting, setting_category, Country,
stressor_type, response_category, yi, vi, sei, effect_size_type)
message(sprintf("Baseline A2 (control arm)          : %d", nrow(baseline_A2)))
message(sprintf("Baseline A1 (lowest-stress obs)    : %d", nrow(baseline_A1)))
message(sprintf("Baseline sex ratio (logit, benign) : %d", nrow(baseline_sexratio)))
# -- Combine and clean -------------------------------------------------
baseline_all <- bind_rows(baseline_A2, baseline_A1, baseline_sexratio) %>%
left_join(study_year_lookup, by = "Study_ID") %>%
mutate(Species = gsub(" ", "_", Species)) %>%
filter(Species %in% study_phylogeny$tip.label, !is.na(sei), sei > 0, sei <= 10,
!is.na(yi),  yi > -10, yi < 10)
# Verify no NA in classification columns -- classifiers should be exhaustive
stopifnot("NA in stressor_type in baseline_all"  = !any(is.na(baseline_all$stressor_type)),
"NA in response_category in baseline_all" = !any(is.na(baseline_all$response_category)))
message(sprintf("Baseline dataset: %d effect sizes | %d studies | %d species",
nrow(baseline_all), n_distinct(baseline_all$Study_ID), n_distinct(baseline_all$Species)))
cat("\n--- Baseline effect sizes by trait category ---\n")
baseline_all %>% count(response_category, sort = TRUE) %>% print(n = Inf)
cat("\n--- Distribution of baseline effect sizes ---\n")
summary(baseline_all$yi)
cat(sprintf("Baseline: %d effect sizes | %d studies | %d species\n", nrow(baseline_all),
n_distinct(baseline_all$Study_ID), n_distinct(baseline_all$Species)))
# Chunk 55: baseline-model
# BAYESIAN PHYLOGENETIC MODEL -- BASELINE (CONTROL) CONDITIONS
baseline_species   <- unique(baseline_all$Species)
baseline_phylo_cov <- phylo_cov_matrix[rownames(phylo_cov_matrix) %in% baseline_species,
colnames(phylo_cov_matrix) %in% baseline_species]
model_baseline_null <- brm(yi | se(sei) ~ 1 + (1 | gr(Species, cov = baseline_phylo_cov)) +
(1 | response_category) + (1 | Study_ID), data    = baseline_all,
data2   = list(baseline_phylo_cov = baseline_phylo_cov), family  = student(), prior   = c(
prior(normal(0, 1),   class = Intercept), prior(cauchy(0, 0.5), class = sd),
prior(gamma(2, 0.1),  class = nu)), cores   = 4, iter = 4000, warmup = 2000,
control = list(adapt_delta = 0.99, max_treedepth = 15), seed    = 13,
file    = file.path(output_dir, "model_baseline_null"))
cat("=== Grand mean baseline sexual dimorphism ===\n")
summary(model_baseline_null)
model_baseline_full <- brm(yi | se(sei) ~ 0 + response_category +
(1 | gr(Species, cov = baseline_phylo_cov)) + (1 | Study_ID),
data    = baseline_all, data2   = list(baseline_phylo_cov = baseline_phylo_cov),
family  = student(), prior   = c(prior(normal(0, 1),   class = b),
prior(cauchy(0, 0.5), class = sd), prior(gamma(2, 0.1),  class = nu)),
cores   = 4, iter = 4000, warmup = 2000, control = list(adapt_delta = 0.99, max_treedepth = 15),
seed    = 13, file    = file.path(output_dir, "model_baseline_full"))
cat("\n=== Trait-category-specific baseline dimorphism ===\n")
summary(model_baseline_full)
# Chunk 56: baseline-posterior-summary
library(posterior)
baseline_params <- as_draws_df(model_baseline_full) %>%
select(starts_with("b_response_category")) %>%
names()
baseline_label_map <- setNames(str_remove(baseline_params, "b_response_category") %>%
str_replace_all("_", " ") %>% str_to_sentence(), nm = baseline_params)
baseline_draws <- as_draws_df(model_baseline_full) %>%
select(all_of(baseline_params)) %>%
pivot_longer(cols = everything(), names_to = ".variable", values_to = ".value") %>%
mutate(trait_label = recode(.variable, !!!baseline_label_map),
# Flag Sex_ratio as a compositional (not trait-magnitude) effect size --
# see "What kind of effect size is this?" in the Statistical Methods
# section. Used to visually separate it in Figure_baseline_dimorphism
# so it is not read as "one more trait" alongside true trait-magnitude
# effect sizes.
effect_type = if_else(trait_label == "Sex ratio", "Compositional (sex ratio)",
"Trait magnitude"))
baseline_posterior_summary <- baseline_draws %>%
group_by(trait_label, effect_type) %>%
summarise(median = round(median(.value), 3), CI_lo  = round(quantile(.value, 0.025), 3),
CI_hi  = round(quantile(.value, 0.975), 3), p_gt0  = round(mean(.value > 0), 3),
p_lt0  = round(mean(.value < 0), 3), .groups = "drop") %>%
mutate(`95% CI`  = sprintf("[%.3f, %.3f]", CI_lo, CI_hi), direction = case_when(
p_gt0 >= 0.95 ~ "Females > Males", p_lt0 >= 0.95 ~ "Males > Females",
TRUE          ~ "No credible dimorphism")) %>%
select(trait_label, effect_type, median, `95% CI`, p_gt0, p_lt0, direction) %>%
arrange(desc(median))
cat("=== Baseline sexual dimorphism by trait category ===\n")
cat("(Hedges' g female - male; Sex ratio = logit proportion female)\n\n")
print(baseline_posterior_summary, n = Inf)
write_csv(baseline_posterior_summary, file.path(output_dir, "baseline_dimorphism_by_trait.csv"))
# Chunk 57: baseline-figure
# FIGURE -- Baseline sexual dimorphism under control conditions
#
# Single panel showing trait-category posteriors from model_baseline_full.
# Sex_ratio is included: its coefficient reflects the logit proportion
# female at the most benign environmental level, so positive = more
# females than males at baseline.
#
# Colour: OI$orange for trait-magnitude effect sizes (consistent with its
# use as the trait colour in the moderator plot, distinct from the stressor
# blue). Sex_ratio is a COMPOSITIONAL effect size, not a trait-magnitude
# one (see "What kind of effect size is this?" in Statistical Methods), so
# it is drawn in OI$grey with a distinct point shape and an italic "(sex
# ratio)" suffix on its axis label, so it cannot be misread as one more
# trait alongside the others.
#
# Format: Ecology Letters single-column (82 mm wide x 130 mm tall).
library(tidybayes)
baseline_plot_data <- baseline_draws %>%
group_by(trait_label) %>%
mutate(median_val = median(.value)) %>%
ungroup() %>%
mutate(trait_label_plot = if_else(effect_type == "Compositional (sex ratio)",
paste0(trait_label, " (sex ratio)"), trait_label))
p_baseline <- baseline_plot_data %>%
ggplot(aes(x = .value, y = reorder(trait_label_plot, median_val), fill   = effect_type,
colour = effect_type, shape  = effect_type)) +
stat_halfeye(.width              = c(0.95), alpha               = 0.75,
point_colour        = "black", point_size          = 1.8, interval_size_range = c(0.5, 1.1)) +
geom_vline(xintercept = 0, linetype = "dashed", colour = "grey30", linewidth = 0.4) +
scale_fill_manual(values = c("Trait magnitude"            = OI$orange,
"Compositional (sex ratio)"  = OI$grey)) +
scale_colour_manual(values = c("Trait magnitude"            = OI$orange,
"Compositional (sex ratio)"  = OI$grey)) +
scale_shape_manual(values = c("Trait magnitude"            = 16,  # filled circle
"Compositional (sex ratio)"  = 21   # open circle
)) +
labs(x = expression(paste("Hedges' ", italic(g), " (female \u2212 male)")), y = NULL,
fill = NULL, colour = NULL, shape = NULL) +
theme_el +
theme(legend.position = "none")
p_baseline
# NOTE: baseline_posterior_summary (including the effect_type column
# distinguishing trait-magnitude from compositional/sex-ratio effect sizes)
# was already computed and printed above; it is intentionally not
# recomputed here to avoid two silently-diverging copies of the same table.
# Chunk 58
ggsave(file.path(fig_dir, "Figure_baseline_dimorphism.tiff"), plot = p_baseline, device = "tiff",
width = 82, height = 130, units = "mm", dpi = 600, compression = "lzw")
# Chunk 59: baseline-stress-correlation
# Is the female - male difference in stress response larger in the trait
# categories where the sexes already differ under control conditions?
# Baseline: female - male under control (model_baseline_full).
# Stress:   female - male stress response (model_sex_category).
baseline_wide <- as_draws_df(model_baseline_full) %>%
as_tibble() %>%
select(starts_with("b_response_category")) %>%
rename_with(~ str_remove(., "b_response_category") %>% str_replace_all("_", " "))
stress_wide <- sex_draws_category %>%
pivot_wider(names_from = Sex, values_from = .value) %>%
mutate(diff = Female - Male) %>%
select(draw_id, level, diff) %>%
pivot_wider(names_from = level, values_from = diff) %>%
select(-draw_id)
# categories present in both models
shared_categories <- intersect(names(baseline_wide), names(stress_wide))
stopifnot("Fewer than 3 response categories shared by the baseline and stress models" =
length(shared_categories) >= 3)
n_draws    <- min(nrow(baseline_wide), nrow(stress_wide))
baseline_m <- as.matrix(baseline_wide[seq_len(n_draws), shared_categories])
stress_m   <- as.matrix(stress_wide[seq_len(n_draws), shared_categories])
# one correlation across categories per posterior draw
r_posterior <- vapply(seq_len(n_draws), function(i) cor(baseline_m[i, ], stress_m[i, ]), numeric(1L))
r_posterior <- r_posterior[!is.na(r_posterior)]
r_median <- median(r_posterior)
r_ci     <- quantile(r_posterior, c(0.025, 0.975))
cat(sprintf(
"Posterior correlation across %d categories (baseline vs stress-response sex difference):\n  Median r = %.3f  95%% CI [%.3f, %.3f]\n  P(r > 0) = %.3f\n",
length(shared_categories), r_median, r_ci[1], r_ci[2], mean(r_posterior > 0)))
# posterior medians, for the points only
dimorphism_comparison <- tibble(trait_label = shared_categories,
baseline_g = apply(baseline_m, 2, median), stress_g = apply(stress_m, 2, median))
p_scatter <- ggplot(dimorphism_comparison, aes(x = baseline_g, y = stress_g, label = trait_label)) +
geom_hline(yintercept = 0, linetype = "dashed", colour = "grey50", linewidth = 0.4) +
geom_vline(xintercept = 0, linetype = "dashed", colour = "grey50", linewidth = 0.4) +
geom_point(size = 3, colour = OI$blue, alpha = 0.85) +
ggrepel::geom_text_repel(size = 2.8, colour = "grey20", max.overlaps = 20) +
geom_smooth(method = "lm", se = TRUE, colour = OI$red, fill = OI$red,
linewidth = 0.7, alpha = 0.12) +
annotate("text", x = -Inf, y = Inf, hjust = -0.1, vjust = 1.5,
label = sprintf("r = %.3f [%.3f, %.3f]", r_median, r_ci[1], r_ci[2]),
size = 3.5, colour = "grey20") +
labs(x = expression(paste("Baseline dimorphism (Hedges' ", italic(g), ", control conditions)")),
y = expression(paste("Female \u2212 male stress response (Hedges' ", italic(g), ")"))) +
theme_el +
theme(legend.position = "none")
p_scatter
# Chunk 60
ggsave(file.path(fig_dir, "Figure_baseline_stress_scatter.tiff"), plot = p_scatter, device = "tiff",
width = 120, height = 84, units = "mm", dpi = 600, compression = "lzw")
# Chunk 61: table-s1
# Dataset composition of the main (sex-specific) data. k = contrasts; each
# contrast has one female and one male effect size.
summarise_moderator <- function(data, var, moderator) {
data %>%
filter(!is.na(.data[[var]])) %>%
group_by(Level = as.character(.data[[var]])) %>%
summarise(k = n_distinct(pair_id), Studies = n_distinct(Study_ID),
Species = n_distinct(Species), .groups = "drop") %>%
mutate(Moderator = moderator, .before = Level) %>%
arrange(desc(k))
}
table_s1 <- bind_rows(
summarise_moderator(sex_joined, "stressor_type", "Stressor type") %>%
mutate(Level = recode(Level, Water_availability = "Water availability")),
summarise_moderator(sex_joined, "setting_category", "Experimental setting") %>%
mutate(Level = recode(Level, Greenhouse_experiment = "Greenhouse",
Field_observation = "Field observation", Field_experiment = "Field experiment")),
summarise_moderator(sex_joined, "growth_form_simple", "Growth form") %>%
mutate(Level = recode(Level, Herbaceous = "Herb/grass")),
summarise_moderator(sex_joined, "dispersal_binary", "Dispersal mode"),
summarise_moderator(sex_joined, "pollen_simple_AB", "Pollination mode") %>%
mutate(Level = recode(Level, Zoophily = "Animal")),
summarise_moderator(sex_joined, "Clonal", "Clonality") %>%
mutate(Level = recode(Level, Yes = "Clonal", No = "Non-clonal")),
summarise_moderator(sex_joined, "response_category", "Trait category"))
print(table_s1, n = Inf)
# Chunk 62
write_csv(
table_s1,
file.path(output_dir, "Table_S1_dataset_composition.csv")
)
