\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces Posterior predictive checks for each vital rate. Dark blue lines show observed data ($y$) and light blue lines show replicated datasets from posterior predictions ($y_{\text  {rep}}$). Strong overlap across survival, growth, inflorescence, and spikelet production indicates adequate model fit for all vital rates.}}{19}{figure.caption.13}\protected@file@percent }
\newlabel{sup:ppc_vital}{{S2}{19}{Posterior predictive checks for each vital rate. Dark blue lines show observed data ($y$) and light blue lines show replicated datasets from posterior predictions ($y_{\text {rep}}$). Strong overlap across survival, growth, inflorescence, and spikelet production indicates adequate model fit for all vital rates}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces Posterior predictive checks for Bayesian models of plant performance in the greenhouse experiment. Density overlays show observed data (solid line) and 200 posterior predictive draws (shaded lines) for (A) aboveground biomass and (B) inflorescence count per plant. Models adequately capture the distribution of observed data across all response variables.}}{20}{figure.caption.14}\protected@file@percent }
\newlabel{sup:ppc_models_soil}{{S3}{20}{Posterior predictive checks for Bayesian models of plant performance in the greenhouse experiment. Density overlays show observed data (solid line) and 200 posterior predictive draws (shaded lines) for (A) aboveground biomass and (B) inflorescence count per plant. Models adequately capture the distribution of observed data across all response variables}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces Proportion of plants damaged by herbivory across sites in 2024 and 2025. Sites are ordered west to east. Error bars indicate standard errors across plots within each site. Panels show results for 2024 (left) and 2025 (right).}}{21}{figure.caption.15}\protected@file@percent }
\newlabel{sup:herb}{{S4}{21}{Proportion of plants damaged by herbivory across sites in 2024 and 2025. Sites are ordered west to east. Error bars indicate standard errors across plots within each site. Panels show results for 2024 (left) and 2025 (right)}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces Proportion of plants damaged by herbivory across sites for \textit  {Agrostis hyemalis}, \textit  {Elymus virginicus}, and \textit  {Poa autumnalis} over 2023--2025. Sites are ordered west to east. Error bars indicate standard errors across plots within each site. Panels are arranged by species (rows) and year (columns).}}{22}{figure.caption.16}\protected@file@percent }
\newlabel{sup:herbsp}{{S5}{22}{Proportion of plants damaged by herbivory across sites for \textit {Agrostis hyemalis}, \textit {Elymus virginicus}, and \textit {Poa autumnalis} over 2023--2025. Sites are ordered west to east. Error bars indicate standard errors across plots within each site. Panels are arranged by species (rows) and year (columns)}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces Posterior estimates (median and 90\% credible intervals) of symbiont and herbivore exclusion effects on the proportion of damaged tillers for three host grass species, from a binomial model with site, year, and plot as random effects. Negative values indicate reduced herbivore damage, whereas positive values indicate increased damage. Back-transformed to predicted proportions of damaged tillers in herbivore-access plots, symbiosis reduced damage in \textit  {P. autumnalis} ($S^+$: 13.5\% vs.\ $S^-$: 17.1\%) and, more weakly, in \textit  {A. hyemalis} ($S^+$: 12.8\% vs.\ $S^-$: 14.2\%), and increased damage in \textit  {E. virginicus} ($S^+$: 62.8\% vs.\ $S^-$: 59.4\%). Points and intervals are colored by species: \textit  {Agrostis hyemalis} (green), \textit  {Elymus virginicus} (orange), and \textit  {Poa autumnalis} (purple). Dashed vertical lines indicate no effect.}}{23}{figure.caption.17}\protected@file@percent }
\newlabel{sup:herbivory}{{S6}{23}{Posterior estimates (median and 90\% credible intervals) of symbiont and herbivore exclusion effects on the proportion of damaged tillers for three host grass species, from a binomial model with site, year, and plot as random effects. Negative values indicate reduced herbivore damage, whereas positive values indicate increased damage. Back-transformed to predicted proportions of damaged tillers in herbivore-access plots, symbiosis reduced damage in \textit {P. autumnalis} ($S^+$: 13.5\% vs.\ $S^-$: 17.1\%) and, more weakly, in \textit {A. hyemalis} ($S^+$: 12.8\% vs.\ $S^-$: 14.2\%), and increased damage in \textit {E. virginicus} ($S^+$: 62.8\% vs.\ $S^-$: 59.4\%). Points and intervals are colored by species: \textit {Agrostis hyemalis} (green), \textit {Elymus virginicus} (orange), and \textit {Poa autumnalis} (purple). Dashed vertical lines indicate no effect}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S7}{\ignorespaces Sensitivity of estimated endophyte effects ($\Delta $ = $S^+ - S^-$) on (a) survival, (b) growth, (c) inflorescence production, and (d) spikelet production to exclusion of sites KER and SON, which were destroyed by deer and subsequently replanted in 2024. Lines and shaded bands show posterior median and 90\% credible intervals for the full dataset (gray) and for the dataset excluding KER and SON (orange). Estimated effects were nearly identical between the two datasets across all species, vital rates, and herbivory treatments, indicating that the disturbance and replanting at these sites did not meaningfully influence our conclusions.}}{24}{figure.caption.18}\protected@file@percent }
\newlabel{fig:sensitivity_KER_SON}{{S7}{24}{Sensitivity of estimated endophyte effects ($\Delta $ = $S^+ - S^-$) on (a) survival, (b) growth, (c) inflorescence production, and (d) spikelet production to exclusion of sites KER and SON, which were destroyed by deer and subsequently replanted in 2024. Lines and shaded bands show posterior median and 90\% credible intervals for the full dataset (gray) and for the dataset excluding KER and SON (orange). Estimated effects were nearly identical between the two datasets across all species, vital rates, and herbivory treatments, indicating that the disturbance and replanting at these sites did not meaningfully influence our conclusions}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S8}{\ignorespaces  Posterior summaries of standardized regression coefficients from Bayesian models of survival, growth, inflorescence production, and spikelet production across three cool-season grass species (\textit  {Agrostis hyemalis}, \textit  {Elymus virginicus}, and \textit  {Poa autumnalis}; spikelet production was modeled for \textit  {E. virginicus} and \textit  {P. autumnalis} only). Panels show median posterior estimates (points), 90\% credible intervals (thick bars), and 95\% credible intervals (thin bars) for main effects of climate (precipitation), endophyte presence, and herbivory, as well as their two-way and three-way interactions. Filled points indicate strong posterior support for an effect ($\mathrm  {Pr}(\Delta > 0)$ or $\mathrm  {Pr}(\Delta < 0) > 0.90$), whereas open points indicate weaker support. Colors distinguish main effects, two-way interactions, and three-way interactions. Vertical dashed lines indicate no effect ($\beta = 0$). Coefficients are shown on the model link scale: logit for survival, linear size scale for growth, and log scale for inflorescence and spikelet production. }}{25}{figure.caption.19}\protected@file@percent }
\newlabel{sup:coef_caterpillar}{{S8}{25}{Posterior summaries of standardized regression coefficients from Bayesian models of survival, growth, inflorescence production, and spikelet production across three cool-season grass species (\textit {Agrostis hyemalis}, \textit {Elymus virginicus}, and \textit {Poa autumnalis}; spikelet production was modeled for \textit {E. virginicus} and \textit {P. autumnalis} only). Panels show median posterior estimates (points), 90\% credible intervals (thick bars), and 95\% credible intervals (thin bars) for main effects of climate (precipitation), endophyte presence, and herbivory, as well as their two-way and three-way interactions. Filled points indicate strong posterior support for an effect ($\mathrm {Pr}(\Delta > 0)$ or $\mathrm {Pr}(\Delta < 0) > 0.90$), whereas open points indicate weaker support. Colors distinguish main effects, two-way interactions, and three-way interactions. Vertical dashed lines indicate no effect ($\beta = 0$). Coefficients are shown on the model link scale: logit for survival, linear size scale for growth, and log scale for inflorescence and spikelet production}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S9}{\ignorespaces Predicted inflorescence production (upper panels) and symbiont effect ($\Delta $ = $S^+ - S^-$; lower panels) across the precipitation gradient. Lines show posterior means with 90\% credible intervals. Points represent mean observed inflorescences per plot, slightly jittered for visualization. The dashed line at $\Delta = 0$ indicates no symbiont effect. Panels are arranged by species and herbivory treatment (herbivore access and exclusion). All panels share a common x-axis for illustrative purposes; some species extend beyond their observed precipitation range.}}{26}{figure.caption.20}\protected@file@percent }
\newlabel{sup:inflo}{{S9}{26}{Predicted inflorescence production (upper panels) and symbiont effect ($\Delta $ = $S^+ - S^-$; lower panels) across the precipitation gradient. Lines show posterior means with 90\% credible intervals. Points represent mean observed inflorescences per plot, slightly jittered for visualization. The dashed line at $\Delta = 0$ indicates no symbiont effect. Panels are arranged by species and herbivory treatment (herbivore access and exclusion). All panels share a common x-axis for illustrative purposes; some species extend beyond their observed precipitation range}{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S10}{\ignorespaces Predicted spikelet production (upper panels) and symbiont effect ($\Delta $ = $S^+ - S^-$; lower panels) across the precipitation gradient. Lines show posterior means with 90\% credible intervals. Points represent mean observed spikelets per plot, slightly jittered for visualization. Spikelets were measured for two species only (see Methods). The dashed line at $\Delta = 0$ indicates no symbiont effect. Panels are arranged by species and herbivory treatment (herbivore access and exclusion). All panels share a common x-axis for illustrative purposes; some species extend beyond their observed precipitation range.}}{27}{figure.caption.21}\protected@file@percent }
\newlabel{sup:spikelet}{{S10}{27}{Predicted spikelet production (upper panels) and symbiont effect ($\Delta $ = $S^+ - S^-$; lower panels) across the precipitation gradient. Lines show posterior means with 90\% credible intervals. Points represent mean observed spikelets per plot, slightly jittered for visualization. Spikelets were measured for two species only (see Methods). The dashed line at $\Delta = 0$ indicates no symbiont effect. Panels are arranged by species and herbivory treatment (herbivore access and exclusion). All panels share a common x-axis for illustrative purposes; some species extend beyond their observed precipitation range}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S11}{\ignorespaces Median $\Delta $ ($S^+ - S^-$) and posterior probability $P(\Delta > 0)$ for spikelet production across precipitation quantiles for each species and herbivory treatment. Herbivore exclusion treatments are indicated by colour. Horizontal dashed lines indicate $\Delta = 0$ for medians and $P(\Delta > 0) = 0.5$ for probabilities. Panels are arranged by metric and species.}}{28}{figure.caption.22}\protected@file@percent }
\newlabel{sup:spike_delta}{{S11}{28}{Median $\Delta $ ($S^+ - S^-$) and posterior probability $P(\Delta > 0)$ for spikelet production across precipitation quantiles for each species and herbivory treatment. Herbivore exclusion treatments are indicated by colour. Horizontal dashed lines indicate $\Delta = 0$ for medians and $P(\Delta > 0) = 0.5$ for probabilities. Panels are arranged by metric and species}{figure.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S12}{\ignorespaces Posterior coefficient estimates for the greenhouse experiment (median, with thick and thin bars showing 90\% and 95\% credible intervals) for symbiont presence, soil-origin precipitation (standardized), and their interaction, for aboveground biomass (top) and total inflorescences (bottom). Filled points indicate estimates with posterior probability $> 0.9$ of being above or below zero; the dashed line marks zero.}}{29}{figure.caption.23}\protected@file@percent }
\newlabel{sup:greenhouse_coef}{{S12}{29}{Posterior coefficient estimates for the greenhouse experiment (median, with thick and thin bars showing 90\% and 95\% credible intervals) for symbiont presence, soil-origin precipitation (standardized), and their interaction, for aboveground biomass (top) and total inflorescences (bottom). Filled points indicate estimates with posterior probability $> 0.9$ of being above or below zero; the dashed line marks zero}{figure.caption.23}{}}
