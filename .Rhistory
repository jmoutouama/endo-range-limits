stroma_site_agh <- dat2425 %>%
filter(Species == "AGHY") %>%
filter(!is.na(stroma_24)) %>%
group_by(Site) %>%
summarise(
prop_stroma = mean(stroma_24 > 0),
n = n(),
se = sqrt(prop_stroma * (1 - prop_stroma) / n),
lower = pmax(0, prop_stroma - 1.96 * se),
upper = pmin(1, prop_stroma + 1.96 * se),
.groups = "drop"
)
ggplot(stroma_site_agh, aes(x = Site, y = prop_stroma)) +
geom_col(fill = "grey40") +
geom_errorbar(
aes(ymin = lower, ymax = upper),
width = 0.2,
linewidth = 0.6
) +
scale_y_continuous(
labels = scales::percent_format(),
limits = c(0, 1)
) +
labs(
x = "Site",
y = "Proportion of tillers with stroma",
title = expression(italic("Agrostis hyemalis"))
) +
theme_light(base_size = 14) +
