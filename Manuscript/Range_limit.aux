\@writefile{lot}{\contentsline {table}{\numberline {S-2}{\ignorespaces Model comparison by vital rate using ELPD (Expected Log Pointwise Density) differences. The values in the \textbf  {elpd\_diff} column represent the difference in the model's ELPD relative to the best model for each vital rate, with positive values indicating a worse model fit. The \textbf  {se\_diff} column shows the standard error of the ELPD difference. Best models for each vital rate are bolded. Model selection is based on the ELPD difference and associated standard error, with smaller ELPD differences and lower standard errors indicating better model fit.}}{19}{table.caption.7}\protected@file@percent }
\newlabel{tab:elpd_vital_rates}{{S-2}{19}{Model comparison by vital rate using ELPD (Expected Log Pointwise Density) differences. The values in the \textbf {elpd\_diff} column represent the difference in the model's ELPD relative to the best model for each vital rate, with positive values indicating a worse model fit. The \textbf {se\_diff} column shows the standard error of the ELPD difference. Best models for each vital rate are bolded. Model selection is based on the ELPD difference and associated standard error, with smaller ELPD differences and lower standard errors indicating better model fit}{table.caption.7}{}}
\@writefile{toc}{\contentsline {section}{\numberline {S.3}Supporting Figures}{20}{section.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {S-1}{\ignorespaces Abiotic conditions across the seven study sites. (A) Mean annual precipitation showing the pronounced east–west aridity gradient from mesic Louisiana to arid Texas. (B) Mean annual temperature across sites, which does not differ much. Panels highlight that precipitation, rather than temperature, constitutes the primary abiotic gradient in this system.}}{20}{figure.caption.8}\protected@file@percent }
\newlabel{Sup:temp}{{S-1}{20}{Abiotic conditions across the seven study sites. (A) Mean annual precipitation showing the pronounced east–west aridity gradient from mesic Louisiana to arid Texas. (B) Mean annual temperature across sites, which does not differ much. Panels highlight that precipitation, rather than temperature, constitutes the primary abiotic gradient in this system}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S-2}{\ignorespaces  Posterior predictive checks for the full demographic model. Dark blue lines show observed data ($y$), and light blue lines show replicated datasets generated from posterior predictions ($y_{\text  {rep}}$). The strong overlap across survival, growth, flowering, and spikelet production indicates adequate model fit for all vital rates. }}{21}{figure.caption.9}\protected@file@percent }
\newlabel{sup:ppc_vital}{{S-2}{21}{Posterior predictive checks for the full demographic model. Dark blue lines show observed data ($y$), and light blue lines show replicated datasets generated from posterior predictions ($y_{\text {rep}}$). The strong overlap across survival, growth, flowering, and spikelet production indicates adequate model fit for all vital rates}{figure.caption.9}{}}
